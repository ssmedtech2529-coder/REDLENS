<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AnemiaScan – Non-Invasive Anaemia Screening System</title>
<style>
:root{--bg:#eef3f6;--card:#fff;--ink:#16222b;--mut:#5d6b76;--line:#d9e2e8;--pri:#0f5c7a;--pri2:#0a4258;--ok:#1a7f4b;--okb:#e4f5ec;--warn:#9a6700;--warnb:#fff3d1;--bad:#b42318;--badb:#fde8e6;--nab:#eceff1}
*{box-sizing:border-box;margin:0;padding:0}
body{font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink)}
header{background:var(--pri2);color:#fff;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:14px}.brand img{height:54px;background:#fff;border-radius:8px;padding:2px 8px}header p{font-size:13px;opacity:.9}
.pill{padding:5px 12px;border-radius:99px;font-size:12px;font-weight:700;background:#9a6700;color:#fff}.pill.ok{background:var(--ok)}.pill.bad{background:var(--bad)}
nav{display:flex;overflow-x:auto;background:var(--pri);position:sticky;top:0;z-index:5}
nav button{background:none;border:0;color:#cfe4ec;padding:13px 16px;font:600 14px inherit;cursor:pointer;border-bottom:4px solid transparent;white-space:nowrap}
nav button.on{color:#fff;border-color:#f2b705}
main{max-width:1050px;margin:18px auto;padding:0 14px 30px}
.tab{display:none}.tab.on{display:block}
.disc{background:var(--warnb);border-left:5px solid var(--warn);padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:14px}
h2{font-size:18px;color:var(--pri2);margin-bottom:10px}h3{font-size:15px;margin:12px 0 6px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}.stat b{display:block;font-size:26px;color:var(--pri2)}.stat span{font-size:13px;color:var(--mut)}
label{display:block;font-size:13px;font-weight:600;color:#33444f}
input,select{width:100%;margin-top:4px;padding:10px;font-size:15px;border:1.5px solid var(--line);border-radius:8px;background:#fff}
input:focus,select:focus{outline:2px solid var(--pri);border-color:var(--pri)}
.chk{display:inline-flex;align-items:center;gap:6px;border:1.5px solid var(--line);border-radius:8px;padding:8px 12px;margin:4px 6px 0 0;font-weight:500;cursor:pointer}.chk input{width:auto;margin:0}
.btn{border:2px solid var(--pri);background:#fff;color:var(--pri);padding:10px 16px;font:700 14px inherit;border-radius:8px;cursor:pointer;margin:4px 6px 4px 0}
.btn:hover{background:#e6f1f5}.btn.p{background:var(--pri);color:#fff}.btn.p:hover{background:var(--pri2)}.btn.d{border-color:var(--bad);color:var(--bad)}.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.badge{display:inline-block;padding:3px 11px;border-radius:99px;font-size:13px;font-weight:700}
.ok{background:var(--okb);color:var(--ok)}.warn{background:var(--warnb);color:var(--warn)}.bad{background:var(--badb);color:var(--bad)}.na{background:var(--nab);color:#455a64}.sim{background:#ede7f6;color:#5e35b1}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:8px;border-bottom:1px solid var(--line);text-align:left}th{color:var(--mut);font-weight:600}.tw{overflow-x:auto}
.cbox{position:relative;background:#101820;border-radius:10px;overflow:hidden;touch-action:none}
canvas{width:100%;display:block;cursor:crosshair;touch-action:none}.roi{position:absolute;border:3px solid #00ff9d;background:rgba(0,255,157,.15);display:none;pointer-events:none}
video{display:none;width:100%;max-width:520px;border-radius:10px;margin-top:8px;background:#000}
.msg{font-size:13px;color:var(--mut);min-height:20px;margin-top:6px}.msg.e{color:var(--bad);font-weight:600}
.sw{display:inline-block;width:34px;height:34px;border-radius:8px;border:1px solid var(--line);vertical-align:middle}
.flow{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:13px;margin-bottom:10px}.flow span{background:#e6f1f5;border-radius:8px;padding:6px 10px;font-weight:600}.flow i{font-style:normal;color:var(--mut)}
.log{background:#101820;color:#9ef0c0;font:12px monospace;padding:10px;border-radius:8px;height:130px;overflow:auto;white-space:pre-wrap}
.kv th{width:20%;background:#f4f7f9}.rep h2{font-size:22px}.sub{color:var(--mut);margin-bottom:8px}.big{font-size:20px;font-weight:800;padding:12px;border-radius:8px;margin:10px 0}
#modal{position:fixed;inset:0;background:#0007;display:none;align-items:flex-start;justify-content:center;overflow:auto;padding:20px;z-index:20}#modal .card{max-width:820px;width:100%}
#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:8px;display:none;z-index:30}
#printArea{display:none}
@media print{body>*:not(#printArea){display:none!important}#printArea{display:block!important}}
</style>
</head>
<body>
<header>
  <div class="brand"><img id="logo" alt="RedLens AI logo"><p>Non-Invasive Anaemia Screening System</p></div>
  <span id="cvPill" class="pill">Loading OpenCV…</span>
</header>
<nav id="nav">
  <button data-t="dash" class="on">Dashboard</button><button data-t="pat">Patient</button><button data-t="img">Image scan</button>
  <button data-t="hb">Hb sensor</button><button data-t="res">Result</button><button data-t="his">History</button><button data-t="hw">Hardware simulation</button>
</nav>
<main>
<div class="disc"><b>Screening only.</b> This application is for screening/research demonstration only. It does not replace a laboratory haemoglobin test or professional medical diagnosis.</div>

<!-- DASHBOARD -->
<section id="t-dash" class="tab on">
  <div class="row" style="justify-content:space-between;margin-bottom:10px"><h2 style="margin:0">Dashboard</h2><button class="btn p" id="newPat">+ New Patient</button></div>
  <div class="grid" id="stats"></div>
  <div class="card" style="margin-top:14px"><h2>Current screening</h2><div id="cur"></div></div>
  <div class="card"><h2>Workflow</h2><div class="flow"><span>Patient</span><i>→</i><span>Image scan</span><i>→</i><span>Hb sensor</span><i>→</i><span>Combined analysis</span><i>→</i><span>Result</span><i>→</i><span>Report / History</span></div></div>
  <div class="card"><h2>Recent screenings</h2><div class="tw" id="recent"></div></div>
</section>

<!-- PATIENT -->
<section id="t-pat" class="tab">
  <div class="card"><h2>Patient registration</h2>
    <div class="grid">
      <label>Patient ID *<input id="pid"></label><label>Name *<input id="pname"></label>
      <label>Age (years) *<input id="page" type="number" min="0.5" max="110" step="0.1"></label>
      <label>Gender *<select id="pgen"><option value="">Select…</option><option>Female</option><option>Male</option></select></label>
      <label>Village / location<input id="pvil"></label><label>Phone (optional)<input id="pph" type="tel"></label>
      <label>Screening centre<input id="pcen"></label><label>Screened by (operator)<input id="pby"></label>
      <label>Screening date and time<input id="pdt" readonly></label>
      <label>Previous anaemia history<select id="phist"><option>No</option><option>Yes</option><option>Not known</option></select></label>
    </div>
    <label id="pregL" style="margin-top:10px;display:none"><span class="chk"><input type="checkbox" id="ppreg"> Pregnant</span></label>
    <h3>Symptoms</h3><div id="syms"></div>
    <div class="row" style="margin-top:12px"><button class="btn p" id="savePat">Save and continue to image scan</button></div><p class="msg" id="patMsg"></p>
  </div>
</section>

<!-- IMAGE -->
<section id="t-img" class="tab">
  <div class="card"><h2>Non-invasive image analysis</h2>
    <div class="flow"><span>Camera / file</span><i>→</i><span>Select ROI</span><i>→</i><span>OpenCV processing</span><i>→</i><span>Colour features</span><i>→</i><span>Analysis</span></div>
    <label style="max-width:300px">Scan site<select id="kind"><option value="nail">Nail bed</option><option value="eye">Lower eyelid (conjunctiva)</option></select></label>
    <p class="msg" id="hint"></p>
    <div class="row"><label class="btn p" style="margin-top:6px">Upload photo<input type="file" id="file" accept="image/*" hidden></label>
      <button class="btn" id="camOn">Open camera</button><button class="btn" id="camCap" disabled>Capture</button><button class="btn" id="imgClr">Clear</button></div>
    <video id="vid" autoplay playsinline muted></video>
    <div class="cbox" style="margin-top:8px"><canvas id="cnv"></canvas><div class="roi" id="roi"></div></div>
    <div class="row"><button class="btn p" id="analyze">Analyze region</button><span id="scanChips"></span></div>
    <p class="msg" id="imgMsg">Upload or capture a photo, then drag a box over the area to measure.</p>
  </div>
  <div class="card" id="scanRes" style="display:none"></div>
  <div class="card" id="probCard"></div>
</section>

<!-- SENSOR -->
<section id="t-hb" class="tab">
  <div class="card"><h2>Hb sensor</h2>
    <div class="flow"><span>Hb sensor</span><i>→</i><span>Microcontroller</span><i>→</i><span>Data</span><i>→</i><span>Web application</span></div>
    <div id="sensBox"></div>
    <div class="grid" style="margin-top:12px">
      <label>Enter Hb manually (g/dL)<input id="hbIn" type="number" min="2" max="25" step="0.1" placeholder="e.g. 10.2"></label>
      <label>Haematocrit, optional (%)<input id="hctIn" type="number" min="5" max="70" step="0.1" placeholder="e.g. 31"></label>
    </div>
    <div class="grid" style="margin-top:12px">
      <label>Pulse rate from MAX30102, optional (bpm)<input id="hrIn" type="number" min="30" max="220" step="1" placeholder="e.g. 78"></label>
      <label>SpO₂ from MAX30102, optional (%)<input id="spo2In" type="number" min="50" max="100" step="1" placeholder="e.g. 98"></label>
    </div>
    <div class="row" style="margin-top:8px"><button class="btn" id="vitSet">Save pulse / SpO₂</button></div>
    <div class="row" style="margin-top:8px"><button class="btn p" id="hbSet">Use manual value</button><button class="btn" id="hbDemo">Demo sensor reading (10.2)</button>
      <button class="btn" id="serOn">Connect real sensor (USB serial)</button><button class="btn d" id="serOff">Disconnect</button><button class="btn" id="hbReset">Reset Hb check</button></div>
    <p class="msg"><b>Two-reading check:</b> take two Hb readings. If they differ by 0.2 g/dL or less, the average is used. If they differ more, retest.</p>
    <p class="msg">Real sensor: an ESP32 sends lines such as <code>Hb:10.2</code> over USB serial (Chrome/Edge, localhost or https). Manual values are tagged "Manual entry"; demo and simulated values are tagged DEMO / SIMULATED.</p>
  </div>
</section>

<!-- RESULT -->
<section id="t-res" class="tab">
  <div class="card" id="resCard"></div>
  <div class="row"><button class="btn" id="rescan">Re-scan</button><button class="btn" id="resNew">New Patient</button><button class="btn p" id="resSave">Save Result</button>
    <button class="btn" id="resPrint">Print Report</button><button class="btn" id="resDl">Download Report</button></div>
</section>

<!-- HISTORY -->
<section id="t-his" class="tab">
  <div class="card"><h2>Screening history</h2>
    <div class="grid"><label>Search (ID or name)<input id="hq"></label>
      <label>Filter by result<select id="hf"><option value="">All results</option><option>Normal Screening Range</option><option>Possible Anaemia</option><option>Needs Further Testing</option><option>Insufficient</option></select></label></div>
    <div class="row" style="margin:8px 0"><button class="btn" id="csv">Export CSV</button><button class="btn" id="json">Export JSON</button></div>
    <div class="tw" id="hist"></div>
  </div>
</section>

<!-- HARDWARE SIM -->
<section id="t-hw" class="tab">
  <div class="card"><h2>Hardware simulation <span class="badge sim">DEMO / SIMULATED DATA</span></h2>
    <div class="flow"><span>Hb sensor</span><i>↓</i><span>ESP32 / microcontroller</span><i>↓</i><span>Serial / Bluetooth / Wi-Fi</span><i>↓</i><span>AnemiaScan</span></div>
    <p>Simulated ESP32 status: <b id="hwSt">Disconnected</b> · Pending reading: <b id="hwPend">none</b></p>
    <div class="row"><button class="btn p" id="hwCon">Connect sensor</button><button class="btn d" id="hwDis">Disconnect sensor</button>
      <button class="btn" id="hwGen">Generate Hb reading</button><button class="btn" id="hwSend">Send reading</button></div>
    <div class="log" id="hwLog"></div>
    <p class="msg">Everything here is simulated in the browser. Values sent from this panel are stored and printed as DEMO / SIMULATED, never as real measurements.</p>
  </div>
</section>
</main>
<div id="modal"><div class="card"><div id="modalBody"></div><div class="row"><button class="btn" id="mPrint">Print</button><button class="btn p" id="mClose">Close</button></div></div></div>
<div id="toast"></div><div id="printArea"></div>

<script>
"use strict";
/* ================= helpers ================= */
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const clamp=(v,a,b)=>Math.min(b,Math.max(a,v)), norm=(v,a,b)=>clamp((v-a)/(b-a),0,1);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const median=a=>{if(!a.length)return NaN;const s=Float32Array.from(a).sort(),m=s.length>>1;return s.length%2?s[m]:(s[m-1]+s[m])/2};
const LS="anemiascan.records.v2";
const load=()=>{try{return JSON.parse(localStorage.getItem(LS))||[]}catch(e){return[]}};
const store=l=>{try{localStorage.setItem(LS,JSON.stringify(l))}catch(e){toast("Could not save: browser storage unavailable.")}};
let tt;function toast(m){const t=$("#toast");t.textContent=m;t.style.display="block";clearTimeout(tt);tt=setTimeout(()=>t.style.display="none",2800)}
const cat=c=>/^Normal/.test(c)?"ok":/^Possible/.test(c)?"bad":/^Needs/.test(c)?"warn":"na";
const isSim=s=>s==="demo"||s==="sim";
const srcLabel=s=>({manual:"Manual entry",serial:"Real sensor (serial)",demo:"DEMO / SIMULATED",sim:"DEMO / SIMULATED"}[s]||"–");
const fdt=iso=>iso?new Date(iso).toLocaleString():"–";
const SYMS=["Tiredness","Dizziness","Breathlessness","Pale skin","Headache","Fast heartbeat"];
const DISC="This application is for screening/research demonstration only. It does not replace a laboratory haemoglobin test or professional medical diagnosis.";

const REPCSS=`.rp{font:13px/1.45 Arial,sans-serif;color:#16222b}.rh{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:4px solid #0a4258;padding-bottom:8px;margin-bottom:8px}.rh img{height:64px}.rh .t{text-align:right}.rh h2{font-size:20px;color:#0a4258;margin:0}
.rm{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px 16px;font-size:12px}.dm{background:#ede7f6;color:#5e35b1;font-weight:700;text-align:center;padding:5px;border-radius:4px;margin:8px 0;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.sec{background:#0a4258;color:#fff;font-weight:700;letter-spacing:.5px;padding:5px 10px;margin:12px 0 4px;font-size:12px;text-transform:uppercase;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.rp table{width:100%;border-collapse:collapse}.rp th,.rp td{border:1px solid #cfd8dc;padding:5px 8px;text-align:left;vertical-align:top}.rp th{background:#eef3f6;color:#33444f;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.rb{font-size:18px;font-weight:800;text-align:center;padding:12px;border-radius:6px;margin:6px 0;border:2px solid;-webkit-print-color-adjust:exact;print-color-adjust:exact}.rb.ok{background:#e4f5ec;color:#1a7f4b}.rb.warn{background:#fff3d1;color:#9a6700}.rb.bad{background:#fde8e6;color:#b42318}.rb.na{background:#eceff1;color:#455a64}
.rp .note{font-size:12px;color:#455a64;font-style:italic;margin:4px 0}.rp p{margin:4px 0}.rp ol{margin-left:20px}.sg{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:6px}.rf{margin-top:10px;font-size:11px;color:#607d8b;border-top:1px solid #cfd8dc;padding-top:6px;text-align:center}`;
document.head.appendChild(Object.assign(document.createElement("style"),{textContent:REPCSS}));
const LOGO="data:image/jpeg;base64,";$("#logo").src=LOGO;
/* ================= state ================= */
const S={patient:null,scans:{nail:null,eye:null},sensor:{hb:null,ts:null,src:null,reads:[],status:"none",diff:null},conn:"Not connected",vitals:null,rec:null,hct:null,rid:null,port:null,reader:null};

/* ================= tabs ================= */
function show(t){
  $$("#nav button").forEach(b=>b.classList.toggle("on",b.dataset.t===t));
  $$(".tab").forEach(s=>s.classList.toggle("on",s.id==="t-"+t));
  if(t==="dash")renderDash(); if(t==="res")renderResult(); if(t==="his")renderHist(); if(t==="hb")renderSensor(); if(t==="img"){renderScan();drawRoi()}
  window.scrollTo({top:0});
}
$("#nav").addEventListener("click",e=>{if(e.target.dataset.t)show(e.target.dataset.t)});

/* ================= OpenCV status ================= */
let cvReady=false;
(function loadCv(){
  const SRC=["https://docs.opencv.org/4.x/opencv.js","https://cdn.jsdelivr.net/npm/@techstark/opencv-js@4.10.0-release.1/dist/opencv.js","https://unpkg.com/@techstark/opencv-js@4.10.0-release.1/dist/opencv.js"];
  const p=$("#cvPill");let i=0,timer=null,done=false;
  const ready=()=>{if(done)return;done=true;clearInterval(timer);cvReady=true;p.textContent="OpenCV ready";p.className="pill ok"};
  const builtin=()=>{if(done)return;done=true;clearInterval(timer);p.textContent="Built-in image engine ready";p.className="pill ok"};
  function check(){
    const c=window.cv;if(!c)return false;
    if(c.Mat){ready();return true}
    if(typeof c.then==="function"&&!c.__w){c.__w=1;c.then(m=>{window.cv=m;if(m&&m.Mat)ready()}).catch(()=>{})}
    else if(!c.onRuntimeInitialized){c.onRuntimeInitialized=()=>{if(window.cv&&window.cv.Mat)ready()}}
    return false}
  function next(){
    if(done)return;
    if(i>=SRC.length){builtin();return}
    const s=document.createElement("script");s.src=SRC[i++];s.async=true;
    let moved=false;const go=()=>{if(moved||done)return;moved=true;next()};
    s.onerror=go;document.head.appendChild(s);
    const t0=Date.now();clearInterval(timer);
    timer=setInterval(()=>{if(check())return;if(Date.now()-t0>25000){clearInterval(timer);go()}},300)}
  p.textContent="Loading OpenCV…";next();
})();

/* ================= patient ================= */
$("#syms").innerHTML=SYMS.map(s=>`<label class="chk"><input type="checkbox" class="sym" value="${s}"> ${s}</label>`).join("");
function newPatient(){
  S.patient=null;S.scans={nail:null,eye:null};S.sensor=freshSensor();S.rec=null;S.hct=null;S.rid=null;S.vitals=null;$("#hrIn").value="";$("#spo2In").value="";$("#hctIn").value="";clearImage();
  ["pname","page","pvil","pph"].forEach(i=>$("#"+i).value="");$("#pgen").value="";$("#phist").value="No";$("#ppreg").checked=false;
  $$(".sym").forEach(c=>c.checked=false);$("#pregL").style.display="none";
  $("#pid").value="ANM-"+String(load().length+1).padStart(3,"0");$("#pdt").value=new Date().toLocaleString();$("#patMsg").textContent="";
  show("pat");
}
$("#pgen").addEventListener("change",()=>{$("#pregL").style.display=$("#pgen").value==="Female"?"block":"none";if($("#pgen").value!=="Female")$("#ppreg").checked=false});
$("#newPat").onclick=newPatient;$("#resNew").onclick=newPatient;
$("#savePat").onclick=()=>{
  const m=$("#patMsg"),age=parseFloat($("#page").value);
  if(!$("#pid").value.trim()||!$("#pname").value.trim()||!$("#pgen").value||!(age>=0.5&&age<=110)){m.textContent="Enter Patient ID, name, a valid age (0.5–110) and gender.";m.className="msg e";return}
  S.patient={id:$("#pid").value.trim(),name:$("#pname").value.trim(),age,gender:$("#pgen").value,village:$("#pvil").value.trim(),phone:$("#pph").value.trim(),
    hist:$("#phist").value,preg:$("#ppreg").checked,symptoms:$$(".sym:checked").map(c=>c.value),dt:new Date().toISOString(),centre:$("#pcen").value.trim(),by:$("#pby").value.trim()};
  S.rid="AS-"+new Date().getFullYear()+"-"+String(Date.now()).slice(-5);m.textContent="Patient saved.";m.className="msg";toast("Patient saved");show("img");
};
$("#pid").value="ANM-"+String(load().length+1).padStart(3,"0");$("#pdt").value=new Date().toLocaleString();

/* ================= image scan ================= */
const SITE={
  eye:{hint:"Pull the lower eyelid down and photograph the pink inner surface in even daylight, no flash. Box only the pink area.",aMin:8,aMax:30,rMin:.37,rMax:.5,minRG:20,minA:8,top:.5},
  nail:{hint:"Photograph a relaxed nail, no polish, even daylight, no flash. Box the central pink part of the nail.",aMin:6,aMax:26,rMin:.36,rMax:.47,minRG:10,minA:5,top:1}
};
const cnv=$("#cnv"),ctx=cnv.getContext("2d",{willReadFrequently:true});let loaded=false,roi=null,drag=null,stream=null;
function blank(){cnv.width=640;cnv.height=360;ctx.fillStyle="#101820";ctx.fillRect(0,0,640,360);ctx.fillStyle="#8aa0ad";ctx.font="20px sans-serif";ctx.textAlign="center";ctx.fillText("Your photo will appear here",320,180)}
blank();
function setImg(w,h,draw){const mw=1000;if(w>mw){h=Math.round(h*mw/w);w=mw}cnv.width=w;cnv.height=h;draw(w,h);loaded=true;roi=null;drawRoi();$("#imgMsg").textContent="Photo ready. Drag a box over the area to measure, then press Analyze."; $("#imgMsg").className="msg"}
function clearImage(){stopCam();loaded=false;roi=null;blank();drawRoi();$("#imgMsg").textContent="Upload or capture a photo, then drag a box over the area to measure.";$("#scanRes").style.display="none"}
$("#imgClr").onclick=clearImage;
$("#kind").onchange=()=>{clearImage();renderScan()};
$("#file").onchange=e=>{const f=e.target.files[0];if(!f)return;stopCam();const im=new Image();
