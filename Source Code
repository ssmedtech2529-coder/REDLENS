const freshSensor=()=>({hb:null,ts:null,src:null,reads:[],status:"none",diff:null});
function hbStatusText(s=S.sensor){
  return s.status==="ok"?`Accepted: the two readings differ by ${s.diff} g/dL (allowed ${HB_TOL}). The average is used.`
   :s.status==="retest"?`RETEST NEEDED: the two readings differ by ${s.diff} g/dL (allowed ${HB_TOL}). Take the Hb reading again.`
   :s.status==="first"?"Reading 1 saved. Take a second reading to confirm.":"No Hb reading yet."}
function setHb(v,src){
  if(!(v>=2&&v<=25)){toast("Hb must be between 2 and 25 g/dL");return false}
  v=+v.toFixed(1);
  const now=new Date().toISOString(),reads=[...S.sensor.reads,{hb:v,src,ts:now}].slice(-2);
  let status="first",hb=v,diff=null,fsrc=src;
  if(reads.length===2){
    diff=Math.round(Math.abs(reads[0].hb-reads[1].hb)*10)/10;
    const sm=reads.find(x=>isSim(x.src));if(sm)fsrc=sm.src;
    if(hbDiffOk(diff)){status="ok";hb=Math.round((reads[0].hb+reads[1].hb)/2*10)/10}
    else{status="retest";hb=null}
  }
  S.sensor={hb,ts:now,src:fsrc,reads,status,diff};renderSensor();
  toast(status==="ok"?`Readings agree (difference ${diff}). Hb = ${hb} g/dL`:status==="retest"?`Readings differ by ${diff} g/dL. Retest needed.`:"Reading 1 saved. Take a second reading.");
  return true}
function renderSensor(){const s=S.sensor,r=s.reads;
  const badge=s.status==="ok"?"ok":s.status==="retest"?"bad":s.status==="first"?"warn":"na";
