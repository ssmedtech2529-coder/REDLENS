  const disc="This is a screening result only. It does not replace a laboratory hemoglobin test or medical diagnosis.";
  if(pr.status==="incomplete"||pr.status==="quality")return`${head}<p class="${nc}">${esc(pr.msg)}</p>`;
  const tbl=`<table><tr><th>Fingernail Hb estimate</th><th>Lower eyelid Hb estimate</th><th>Difference</th></tr><tr><td>${pr.hb1.toFixed(1)} g/dL</td><td>${pr.hb2.toFixed(1)} g/dL</td><td>${pr.diff.toFixed(1)} g/dL (allowed ${HB_TOL})</td></tr></table>`;
  if(pr.status==="fail")return`${head}<div style="background:#fde8e6;color:#b42318;border:2px solid #b42318;border-radius:8px;padding:12px;font-weight:800;margin:8px 0;-webkit-print-color-adjust:exact;print-color-adjust:exact">${esc(pr.msg)}</div><p>${esc(pr.detail)}</p>${tbl}<p class="${nc}">${disc}</p>`;
  const r=pr.risk;
  return`${head}<p style="color:#1a7f4b;font-weight:700;margin:4px 0">${MSG_OK}</p>${tbl}
  <div style="margin:10px 0;padding:12px;border-radius:8px;border:2px solid ${r.col};background:${r.bg};color:${r.col};-webkit-print-color-adjust:exact;print-color-adjust:exact">
