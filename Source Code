#aic-set{display:none;padding:10px 12px;background:#f4f7f9;border-bottom:1px solid #d9e2e8;font-size:12px;overflow:auto;max-height:55%}
#aic-set.open{display:block}
#aic-set label{display:block;font-weight:600;margin-top:6px;color:#33444f}
#aic-set input,#aic-set select{width:100%;margin-top:3px;padding:7px;font-size:13px;border:1.5px solid #d9e2e8;border-radius:6px;background:#fff}
#aic-set .n{color:#5d6b76;margin-top:6px}
#aic-set button{margin-top:8px;border:2px solid #0f5c7a;background:#0f5c7a;color:#fff;border-radius:8px;padding:7px 12px;font-weight:700;cursor:pointer}
#aic-msgs{flex:1;overflow-y:auto;padding:10px 12px;background:#eef3f6;display:flex;flex-direction:column;gap:8px}
.aic-m{max-width:88%;padding:8px 11px;border-radius:12px;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere}
.aic-m.u{align-self:flex-end;background:#0f5c7a;color:#fff;border-bottom-right-radius:3px}
.aic-m.b{align-self:flex-start;background:#fff;border:1px solid #d9e2e8;border-bottom-left-radius:3px}
.aic-m.e{align-self:flex-start;background:#fde8e6;color:#b42318;border:1px solid #b42318}
.aic-m.t{align-self:flex-start;background:#fff;border:1px solid #d9e2e8;color:#5d6b76;font-style:italic}
.aic-m button.aic-say{display:block;margin-top:6px;border:1px solid #d9e2e8;background:#f4f7f9;border-radius:6px;padding:2px 8px;font-size:12px;cursor:pointer}
#aic-chips{padding:6px 10px;display:flex;flex-wrap:wrap;gap:6px;background:#eef3f6;border-top:1px solid #d9e2e8;max-height:96px;overflow:auto}
#aic-chips button{border:1.5px solid #0f5c7a;background:#fff;color:#0f5c7a;border-radius:99px;padding:4px 10px;font-size:12px;font-weight:600;cursor:pointer}
#aic-chips button.hot{background:#fff3d1;border-color:#9a6700;color:#9a6700}
.aic-in{display:flex;gap:6px;padding:8px;border-top:1px solid #d9e2e8;background:#fff;align-items:flex-end}
#aic-txt{flex:1;resize:none;max-height:90px;min-height:38px;padding:8px;font:14px/1.4 inherit;border:1.5px solid #d9e2e8;border-radius:8px}
#aic-txt:focus{outline:2px solid #0f5c7a;border-color:#0f5c7a}
.aic-in button{width:40px;height:40px;border-radius:8px;border:0;background:#0f5c7a;color:#fff;font-size:18px;cursor:pointer;flex:none}
.aic-in button:disabled{opacity:.45;cursor:not-allowed}
#aic-mic.rec{background:#b42318;animation:aicp 1s infinite}
@keyframes aicp{50%{opacity:.55}}
.aic-foot{font-size:10.5px;color:#5d6b76;padding:3px 10px 6px;background:#fff}
@media (max-width:480px){#aic-panel{right:8px;left:8px;width:auto;max-width:none;bottom:84px}}
