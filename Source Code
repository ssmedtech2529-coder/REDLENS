<button id="aic-fab" type="button" aria-label="Open AI help chat" title="AI help">💬<span id="aic-dot"></span></button>
<div id="aic-panel" role="dialog" aria-label="AI help chat">
  <div class="aic-head">
    <b>AI Help<small>Ask in any language · text or voice</small></b>
    <button class="aic-ib" id="aic-spk" type="button" title="Read answers aloud (on/off)">🔊</button>
    <button class="aic-ib" id="aic-gear" type="button" title="Settings">⚙</button>
    <button class="aic-ib" id="aic-new" type="button" title="Clear chat">🗑</button>
    <button class="aic-ib" id="aic-x" type="button" title="Close">✕</button>
  </div>
  <div id="aic-set">
    <label>Gemini API key (stored only in this browser)
      <input id="aic-key" type="password" autocomplete="off" placeholder="AIza... / AQ...."></label>
    <label>Proxy / backend URL (optional, recommended for real use)
      <input id="aic-ep" type="url" placeholder="https://your-server/chat  (leave empty for direct Gemini API)"></label>
    <label>Model
      <input id="aic-model" type="text" placeholder="gemini-flash-latest"></label>
    <label>Voice input language
      <select id="aic-lang">
        <option value="auto">Auto (browser / last reply language)</option>
        <option value="ta-IN">தமிழ் (Tamil)</option><option value="en-IN">English (India)</option><option value="en-US">English (US)</option>
        <option value="hi-IN">हिन्दी (Hindi)</option><option value="te-IN">తెలుగు (Telugu)</option><option value="kn-IN">ಕನ್ನಡ (Kannada)</option>
        <option value="ml-IN">മലയാളം (Malayalam)</option><option value="mr-IN">मराठी (Marathi)</option><option value="bn-IN">বাংলা (Bengali)</option>
        <option value="gu-IN">ગુજરાતી (Gujarati)</option><option value="pa-IN">ਪੰਜਾਬੀ (Punjabi)</option><option value="ur-PK">اردو (Urdu)</option>
        <option value="ne-NP">नेपाली (Nepali)</option><option value="si-LK">සිංහල (Sinhala)</option>
        <option value="ar-SA">العربية (Arabic)</option><option value="es-ES">Español</option><option value="fr-FR">Français</option>
        <option value="de-DE">Deutsch</option><option value="pt-BR">Português</option><option value="ru-RU">Русский</option>
        <option value="zh-CN">中文</option><option value="ja-JP">日本語</option><option value="ko-KR">한국어</option>
        <option value="id-ID">Bahasa Indonesia</option><option value="sw-KE">Kiswahili</option>
      </select></label>
    <p class="n">Typing works in every language. For voice, the browser listens in the language selected above (Chrome / Edge / Safari). The AI always replies in the language you write or speak.</p>
    <p class="n">⚠ A key saved in the browser is fine for a prototype only. For a real deployment, send requests through your own server (Proxy URL) so the key stays secret.</p>
    <button id="aic-save" type="button">Save settings</button>
  </div>
  <div id="aic-msgs" aria-live="polite"></div>
  <div id="aic-chips"></div>
  <div class="aic-in">
    <button id="aic-mic" type="button" title="Speak" aria-label="Speak">🎤</button>
    <textarea id="aic-txt" rows="1" placeholder="Type your doubt in any language…"></textarea>
    <button id="aic-send" type="button" title="Send" aria-label="Send">➤</button>
  </div>
  <div class="aic-foot">AI help is for guidance only. Screening result is not a diagnosis. Confirm with a laboratory Hb test.</div>
</div>

<script>
(function(){
"use strict";
var CK="anemiascan.chat.gemini.v1";
/* Gemini key supplied by the owner. NOTE: anyone who opens this HTML file can read it. Restrict the key in Google AI Studio (HTTP referrer / quota) or use a Proxy URL in settings. */
var DEFAULT_KEY="AQ.Ab8RN6Lq5cF_5KiWLJfwbXrAzpD2KtwCoWgBADL8rQhgtTb6cw";
var DEF={key:DEFAULT_KEY,endpoint:"",model:"gemini-flash-latest",speak:true,lang:"auto"};
var FALLBACK=["gemini-flash-latest","gemini-2.5-flash","gemini-2.0-flash"];
var BASE="https://generativelanguage.googleapis.com/v1beta/models/";
var cfg=loadCfg();
var hist=[];            /* {role:"user"|"assistant", content:string} */
var busy=false,rec=null,recOn=false,lastLang="",issue="",abortCtl=null;

function g(id){return document.getElementById(id)}
function loadCfg(){try{var o=JSON.parse(localStorage.getItem(CK));return Object.assign({},DEF,o||{})}catch(e){return Object.assign({},DEF)}}
function saveCfg(){try{localStorage.setItem(CK,JSON.stringify(cfg))}catch(e){}}

/* ---------- UI helpers ---------- */
var msgs=g("aic-msgs");
function add(cls,text,say){
  var d=document.createElement("div");d.className="aic-m "+cls;d.textContent=text;
  if(say){var b=document.createElement("button");b.type="button";b.className="aic-say";b.textContent="🔊 Listen";
    b.onclick=function(){speak(text,say)};d.appendChild(b)}
  msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;return d}
function setBusy(v){busy=v;g("aic-send").disabled=v;g("aic-txt").disabled=v&&false}
function openPanel(o){
  var p=g("aic-panel");p.classList.toggle("open",o);
  if(o){g("aic-dot").style.display="none";g("aic-txt").focus();refreshChips();if(!msgs.children.length)welcome()}
  else{stopSpeak();stopRec()}}
function welcome(){
  add("b","Vanakkam! 👋 I am the AnemiaScan help assistant.\nAsk me anything about this app, an error message, or anaemia screening – in any language, by typing or by voice (🎤).\n\nவணக்கம்! இந்த ஆப் பற்றிய உங்கள் சந்தேகத்தை எந்த மொழியிலும் கேளுங்கள்.")}

/* ---------- app context (no name / phone / village is ever sent) ---------- */
function appContext(){
  var o={};
  try{
    var on=document.querySelector("#nav button.on");o.activeTab=on?on.dataset.t:"unknown";
    if(typeof S!=="undefined"&&S){
      var p=S.patient;o.patientRegistered=!!p;
      if(p){o.patientAge=p.age;o.patientGender=p.gender;o.pregnant=!!p.preg}
      var sc=function(s){return s?{pallorScore:s.rejected?null:s.pallor,imageQuality:["Good","Moderate","Poor"][s.level],rejected:!!s.rejected,issues:s.issues}:"not scanned"};
      o.nailScan=sc(S.scans&&S.scans.nail);o.eyeScan=sc(S.scans&&S.scans.eye);
      if(S.sensor)o.hbSensor={finalHb:S.sensor.hb,status:S.sensor.status,readings:(S.sensor.reads||[]).map(function(r){return r.hb}),difference:S.sensor.diff,source:S.sensor.src};
      o.vitalsEntered=!!S.vitals;
    }
    var vis=[];["patMsg","imgMsg"].forEach(function(id){var e=g(id);if(e&&e.textContent.trim())vis.push(e.textContent.trim())});
    var t=g("toast");if(t&&t.style.display==="block"&&t.textContent.trim())vis.push(t.textContent.trim());
    if(issue)vis.push(issue);
    o.messagesOnScreen=vis.slice(0,5);
  }catch(e){}
  return o}

var SYSTEM=[
"You are the built-in help assistant of AnemiaScan (RedLens AI), a prototype non-invasive anaemia screening web app. Help users who are confused or made a mistake.",
"APP FACTS: Tabs = Dashboard, Patient, Image scan, Hb sensor, Result, History, Hardware simulation. Workflow: register patient -> image scan (nail bed and lower eyelid) -> Hb reading -> Result -> save/print/download report.",
"Patient tab needs Patient ID, name, valid age (0.5 to 110) and gender; pregnancy box appears only for females.",
"Image scan: upload a photo or open camera and capture; then DRAG a box over only the pink area (nail centre or inner lower eyelid), then press Analyze region. Use even daylight, no flash, no nail polish. The box must be at least 10 px. A region is rejected if it is not red enough, has glare, deep shadow, white/shiny parts or bad exposure; then retake. Both nail and eye scans are needed for the probability score.",
"Hb sensor tab: Hb must be between 2 and 25 g/dL; haematocrit 5-70 %; pulse 30-220 bpm; SpO2 50-100 %. Two-reading rule: take two Hb readings; if they differ by 0.2 g/dL or less, the average is used; if they differ more, retest (use Reset Hb check and start again). Manual values are tagged Manual entry. Demo and Hardware simulation values are fake DEMO / SIMULATED data, not real measurements. Real sensor needs an ESP32 sending lines like Hb:10.2 over USB serial in Chrome or Edge on localhost or https.",
"Probability score: estimated Hb from nail and from eyelid must agree within 0.2 g/dL, otherwise the message 'Image consistency failed' appears and both images must be retaken.",
"Results are screening indications only (rule-based colour analysis, prototype thresholds), never a diagnosis. WHO Hb cut-offs used: children under 5 y 11; 5-11 y 11.5; 12-14 y 12; non-pregnant women 12; pregnant women 11; men 13 g/dL.",
"The CURRENT APP STATE below is JSON from the live app; use it to explain exactly what the user should fix next, in simple numbered steps.",
"SAFETY: never diagnose, never prescribe medicine or doses. Recommend a laboratory Hb test (CBC) and a doctor for confirmation. If the user mentions chest pain, fainting, severe breathlessness, very fast heartbeat at rest, heavy bleeding or pregnancy with severe symptoms, tell them to get urgent medical care now.",
"SCOPE: answer about this app, anaemia screening, and general anaemia/nutrition information. Politely decline unrelated topics.",
"LANGUAGE (very important): reply in the SAME language and SAME script the user used. If the user writes Tamil (or any language) in English letters, reply the same way in English letters. If the user mixes languages, follow the main one. Use simple everyday words.",
"FORMAT: the very first line of every reply must be exactly [[lang:XX-YY]] where XX-YY is the BCP-47 tag of the language you reply in (examples: ta-IN, hi-IN, en-US, ar-SA, es-ES). Then write the answer on the next lines. Plain text only: no markdown symbols (no **, #, backticks, tables). Keep it short; use numbered steps only when giving instructions."
].join("\n");

/* ---------- API (Google Gemini) ---------- */
function buildBody(){
  return {
    systemInstruction:{parts:[{text:SYSTEM+"\n\nCURRENT APP STATE:\n"+JSON.stringify(appContext())}]},
    contents:hist.slice(-14).map(function(m){return {role:m.role==="assistant"?"model":"user",parts:[{text:m.content}]}}),
    generationConfig:{maxOutputTokens:2048,temperature:0.4},
    safetySettings:["HARM_CATEGORY_HARASSMENT","HARM_CATEGORY_HATE_SPEECH","HARM_CATEGORY_SEXUALLY_EXPLICIT","HARM_CATEGORY_DANGEROUS_CONTENT"].map(function(c){return {category:c,threshold:"BLOCK_ONLY_HIGH"}})
  }}
function parseReply(j){
  var txt="";
  if(j&&Array.isArray(j.candidates)&&j.candidates[0]&&j.candidates[0].content&&Array.isArray(j.candidates[0].content.parts))
    txt=j.candidates[0].content.parts.map(function(p){return p.text||""}).join("");
  else if(j&&typeof j.reply==="string")txt=j.reply;
  else if(j&&typeof j.text==="string")txt=j.text;
  return txt}
function callModel(model,body){
  var url=cfg.endpoint||(BASE+encodeURIComponent(model)+":generateContent");
  var headers={"content-type":"application/json"};
  if(cfg.key)headers["x-goog-api-key"]=cfg.key;
  if(!cfg.endpoint&&!cfg.key)return Promise.reject({code:"nokey"});
  var ctl=new AbortController();abortCtl=ctl;var to=setTimeout(function(){ctl.abort()},60000);
  return fetch(url,{method:"POST",headers:headers,body:JSON.stringify(body),signal:ctl.signal}).then(function(r){
    clearTimeout(to);
    return r.text().then(function(t){
      var j=null;try{j=JSON.parse(t)}catch(e){}
      if(!r.ok){var m=j&&j.error&&(j.error.message||j.error)||t.slice(0,200);throw {code:"http",status:r.status,msg:String(m)}}
      var txt=parseReply(j);
      if(!txt.trim()){
        var br=j&&j.promptFeedback&&j.promptFeedback.blockReason;
        throw br?{code:"blocked"}:{code:"empty"}}
      return txt});
  },function(e){clearTimeout(to);throw (e&&e.name==="AbortError")?{code:"timeout"}:{code:"net"}});
}
function callAI(){
  var body=buildBody();
  var list=[];[cfg.model].concat(FALLBACK).forEach(function(m){if(m&&list.indexOf(m)<0)list.push(m)});
  if(cfg.endpoint)list=[list[0]];
  function tryAt(i){
    return callModel(list[i],body).catch(function(e){
      /* wrong / retired model name -> try the next model automatically */
      if(e&&e.code==="http"&&(e.status===404||(e.status===400&&/model/i.test(e.msg||"")&&!/api key/i.test(e.msg||"")))&&i+1<list.length)return tryAt(i+1);
      throw e})}
  return tryAt(0)}
function errText(e){
  var c=e&&e.code;
  if(c==="nokey")return "Please add your Gemini API key (⚙ settings) or a proxy URL to start the AI help.\nAPI key (⚙ settings) kodunga, appo AI help work aagum.";
  if(c==="timeout")return "The AI took too long. Please try again.\nNeram aachu, thirumba try pannunga.";
  if(c==="net")return "Could not reach the AI. Check your internet connection and try again. If it keeps failing, open the page from http://localhost or https instead of a plain file.\nInternet check pannunga.";
  if(c==="blocked")return "The AI could not answer that question. Please rephrase it.";
  if(c==="empty")return "The AI sent an empty answer. Please ask again.";
  if(c==="http"){
    var m=e.msg||"";
    if(e.status===400&&/api key|API_KEY/i.test(m))return "The Gemini API key is not valid. Please check the key in ⚙ settings.";
    if(e.status===401||e.status===403)return "The Gemini API key was rejected or is not allowed for this site (status "+e.status+"). Check the key and its restrictions in Google AI Studio.";
    if(e.status===429)return "Gemini limit reached right now. Wait a minute and try again.";
    if(e.status===404||e.status===400)return "The AI request was refused ("+e.status+"). Check the model name in ⚙ settings. "+m;
    return "AI service error ("+e.status+"). Please try again later."}
  return "Something went wrong. Please try again."}

/* ---------- send ---------- */
function send(text){
  text=(text||"").trim();if(!text||busy)return;
  stopSpeak();stopRec();
  add("u",text);hist.push({role:"user",content:text});g("aic-txt").value="";autoGrow();
  var t=add("t","…thinking");setBusy(true);
  callAI().then(function(raw){
    var m=raw.match(/^\s*\[\[lang:([A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)\]\]\s*/),lang="";
    if(m){lang=m[1];raw=raw.slice(m[0].length)}
    raw=raw.replace(/\*\*|__|`{1,3}|^#{1,6}\s*/gm,"").trim();
    if(lang)lastLang=lang;
    t.remove();add("b",raw,lang||lastLang||"en-US");hist.push({role:"assistant",content:raw});
    if(cfg.speak)speak(raw,lang||lastLang||"en-US");
  }).catch(function(e){
    t.remove();hist.pop();add("e",errText(e));
  }).then(function(){setBusy(false);refreshChips()});
}

/* ---------- text to speech ---------- */
var synth=window.speechSynthesis||null;
function stopSpeak(){try{if(synth)synth.cancel()}catch(e){}}
function pickVoice(lang){
  if(!synth)return null;var vs=synth.getVoices()||[],p=lang.split("-")[0].toLowerCase(),i;
  for(i=0;i<vs.length;i++)if(vs[i].lang.replace("_","-").toLowerCase()===lang.toLowerCase())return vs[i];
  for(i=0;i<vs.length;i++)if(vs[i].lang.toLowerCase().indexOf(p)===0)return vs[i];
  return null}
function chunks(t){
  var out=[],parts=t.replace(/\s+/g," ").match(/[^.!?।。؟\n]+[.!?।。؟]*/g)||[t],cur="";
  parts.forEach(function(s){if((cur+s).length>170&&cur){out.push(cur);cur=s}else cur+=s});
  if(cur.trim())out.push(cur);return out}
function speak(text,lang){
  if(!synth||!text)return;stopSpeak();lang=lang||"en-US";
  var clean=text.replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/gu,"");
  var v=pickVoice(lang);
  chunks(clean).forEach(function(c){var u=new SpeechSynthesisUtterance(c);u.lang=v?v.lang:lang;if(v)u.voice=v;u.rate=0.95;synth.speak(u)})}
if(synth&&synth.addEventListener)synth.addEventListener("voiceschanged",function(){});

/* ---------- voice input ---------- */
var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
function recLang(){
  if(cfg.lang&&cfg.lang!=="auto")return cfg.lang;
  return lastLang||navigator.language||"en-US"}
function stopRec(){recOn=false;g("aic-mic").classList.remove("rec");try{rec&&rec.stop()}catch(e){}}
function startRec(){
  if(!SR){add("e","Voice input is not supported in this browser. Please use Chrome, Edge or Safari, or type your question.");return}
  if(busy)return;
  if(recOn){stopRec();return}
  stopSpeak();
  try{
    rec=new SR();rec.lang=recLang();rec.interimResults=true;rec.continuous=false;rec.maxAlternatives=1;
    var finalT="";
    rec.onstart=function(){recOn=true;g("aic-mic").classList.add("rec");g("aic-txt").placeholder="Listening… ("+rec.lang+")"};
    rec.onresult=function(ev){
      var interim="";finalT="";
      for(var i=0;i<ev.results.length;i++){var r=ev.results[i];if(r.isFinal)finalT+=r[0].transcript;else interim+=r[0].transcript}
      g("aic-txt").value=(finalT+interim).trim();autoGrow()};
    rec.onerror=function(ev){
      var m={"not-allowed":"Microphone permission is blocked. Allow the microphone and use https or localhost.","service-not-allowed":"Microphone permission is blocked. Allow the microphone and use https or localhost.",
        "no-speech":"I did not hear anything. Tap 🎤 and speak again.","audio-capture":"No microphone found.","network":"Voice service needs internet.","language-not-supported":"This language is not supported for voice input. Pick another in ⚙ settings or type."}[ev.error];
      if(m&&ev.error!=="aborted")add("e",m)};
    rec.onend=function(){recOn=false;g("aic-mic").classList.remove("rec");g("aic-txt").placeholder="Type your doubt in any language…";
      var v=g("aic-txt").value.trim();if(v&&finalT.trim())send(v)};
    rec.start();
  }catch(e){recOn=false;add("e","Could not start the microphone. Please try again.")}}

/* ---------- chips + auto help on error messages ---------- */
var CHIPS=["How do I use this app?","Image scan eppadi edukkanum?","Hb retest-nu varudhu, enna pannanum?","Anaemia na enna?","இந்த result-ஐ எப்படி புரிந்து கொள்வது?"];
function refreshChips(){
  var c=g("aic-chips");c.innerHTML="";
  if(issue){var b=document.createElement("button");b.type="button";b.className="hot";b.textContent="❓ Explain this message";
    b.onclick=function(){var q="Please explain this message from the app and tell me exactly what to do: "+issue;issue="";send(q)};c.appendChild(b)}
  CHIPS.forEach(function(t){var b=document.createElement("button");b.type="button";b.textContent=t;b.onclick=function(){send(t)};c.appendChild(b)})}
function watch(id){
  var el=g(id);if(!el||!window.MutationObserver)return;
  new MutationObserver(function(){
    var t=(el.textContent||"").trim();
    var bad=id==="toast"?(el.style.display==="block"&&/(must|could not|retest|differ|enter|not supported|too|nothing|no records)/i.test(t)):el.classList.contains("e");
    if(bad&&t&&t!==issue){issue=t;if(!g("aic-panel").classList.contains("open"))g("aic-dot").style.display="block";else refreshChips()}
  }).observe(el,{childList:true,characterData:true,subtree:true,attributes:true,attributeFilter:["class","style"]})}
["patMsg","imgMsg","toast"].forEach(watch);

/* ---------- settings ---------- */
function fillSet(){g("aic-key").value=cfg.key||"";g("aic-ep").value=cfg.endpoint||"";g("aic-model").value=cfg.model||"";g("aic-lang").value=cfg.lang||"auto"}
function spkUi(){var b=g("aic-spk");b.textContent=cfg.speak?"🔊":"🔇";b.classList.toggle("off",!cfg.speak)}
function autoGrow(){var t=g("aic-txt");t.style.height="auto";t.style.height=Math.min(t.scrollHeight,90)+"px"}

g("aic-fab").onclick=function(){openPanel(!g("aic-panel").classList.contains("open"))};
g("aic-x").onclick=function(){openPanel(false)};
g("aic-gear").onclick=function(){g("aic-set").classList.toggle("open")};
g("aic-new").onclick=function(){stopSpeak();stopRec();hist=[];msgs.innerHTML="";welcome()};
g("aic-spk").onclick=function(){cfg.speak=!cfg.speak;if(!cfg.speak)stopSpeak();saveCfg();spkUi()};
g("aic-save").onclick=function(){
  cfg.key=g("aic-key").value.trim();cfg.endpoint=g("aic-ep").value.trim();cfg.model=g("aic-model").value.trim()||DEF.model;cfg.lang=g("aic-lang").value;
  saveCfg();g("aic-set").classList.remove("open");add("b","Settings saved ✔")};
g("aic-send").onclick=function(){send(g("aic-txt").value)};
g("aic-mic").onclick=startRec;
g("aic-txt").addEventListener("input",autoGrow);
g("aic-txt").addEventListener("keydown",function(e){if(e.key==="Enter"&&!e.shiftKey&&!e.isComposing){e.preventDefault();send(g("aic-txt").value)}});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&g("aic-panel").classList.contains("open"))openPanel(false)});
window.addEventListener("beforeunload",function(){stopSpeak()});
if(!SR)g("aic-mic").title="Voice input not supported in this browser";
fillSet();spkUi();
})();
</script>
</body>
</html>
