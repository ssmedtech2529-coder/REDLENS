  <div class="stat"><b style="font-size:16px">${esc(S.conn)}</b><span>Sensor connection</span></div>
  <div class="stat"><b style="font-size:16px">${fdt(s.ts)}</b><span>Last reading</span></div>
  <div class="stat"><b style="font-size:16px"><span class="badge ${isSim(s.src)?"sim":s.src?"ok":"na"}">${srcLabel(s.src)}</span></b><span>Source</span></div></div>
