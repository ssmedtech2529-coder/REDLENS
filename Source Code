/* Built-in RGB -> HSV / Lab (same 8-bit layout as OpenCV) used when OpenCV is unavailable */
function jsConvert(im){
  const d=im.data,n=im.width*im.height,rd=new Uint8Array(n*3),hd=new Uint8Array(n*3),ld=new Uint8Array(n*3);
  const f=t=>t>0.008856?Math.cbrt(t):7.787*t+16/116,lin=c=>{c/=255;return c<=0.04045?c/12.92:Math.pow((c+0.055)/1.055,2.4)};
  for(let p=0;p<n;p++){
    const r=d[p*4],g=d[p*4+1],b=d[p*4+2];rd[p*3]=r;rd[p*3+1]=g;rd[p*3+2]=b;
    const mx=Math.max(r,g,b),mn=Math.min(r,g,b),df=mx-mn;let h=0;
    if(df){h=mx===r?60*(g-b)/df:mx===g?120+60*(b-r)/df:240+60*(r-g)/df;if(h<0)h+=360}
    hd[p*3]=Math.round(h/2)%180;hd[p*3+1]=mx?Math.round(255*df/mx):0;hd[p*3+2]=mx;
    const R=lin(r),G=lin(g),B=lin(b);
    const X=(0.412453*R+0.357580*G+0.180423*B)/0.950456,Y=0.212671*R+0.715160*G+0.072169*B,Z=(0.019334*R+0.119193*G+0.950227*B)/1.088754;
    const fy=f(Y),L=Y>0.008856?116*fy-16:903.3*Y;
    ld[p*3]=clamp(Math.round(L*255/100),0,255);ld[p*3+1]=clamp(Math.round(500*(f(X)-fy)+128),0,255);ld[p*3+2]=clamp(Math.round(200*(fy-f(Z))+128),0,255);
  }
  return{rd,hd,ld};
}
/* Colour analysis of the selected box (screening estimate only) */
function analyze(){
  const kind=$("#kind").value,cfg=SITE[kind],m=$("#imgMsg");m.className="msg e";
  if(!loaded){m.textContent="Upload or capture a photo first.";return}
  if(!roi){m.textContent="Drag a box over the area first.";return}
  const rx=clamp(Math.round(roi.x),0,cnv.width-1),ry=clamp(Math.round(roi.y),0,cnv.height-1),rw=clamp(Math.round(roi.w),1,cnv.width-rx),rh=clamp(Math.round(roi.h),1,cnv.height-ry);
  let src,reg,rgb,hsv,lab;
  try{
    let rd,hd,ld;
    if(cvReady){
      src=cv.imread(cnv);reg=src.roi(new cv.Rect(rx,ry,rw,rh));rgb=new cv.Mat();cv.cvtColor(reg,rgb,cv.COLOR_RGBA2RGB);
      hsv=new cv.Mat();cv.cvtColor(rgb,hsv,cv.COLOR_RGB2HSV);lab=new cv.Mat();cv.cvtColor(rgb,lab,cv.COLOR_RGB2Lab);
      rd=rgb.data;hd=hsv.data;ld=lab.data;
    }else{({rd,hd,ld}=jsConvert(ctx.getImageData(rx,ry,rw,rh)))}
    const n=rw*rh,step=Math.max(1,Math.floor(n/40000));
    const B={R:[],G:[],B:[],H:[],S:[],V:[],A:[]};let seen=0,glare=0,dark=0,white=0;
    for(let p=0;p<n;p+=step){seen++;const r=rd[p*3],g=rd[p*3+1],b=rd[p*3+2],gr=.299*r+.587*g+.114*b;
      if(gr>=245){glare++;continue}if(gr<=35){dark++;continue}
      if(hd[p*3+1]<25&&hd[p*3+2]>185){white++;continue}
      B.R.push(r);B.G.push(g);B.B.push(b);B.H.push(hd[p*3]);B.S.push(hd[p*3+1]);B.V.push(hd[p*3+2]);B.A.push(ld[p*3+1]-128)}
    const valid=B.R.length;
    if(valid<50){m.textContent="Not enough usable colour in the box (glare, shadow or white). Choose a better spot or retake.";return}
    if(cfg.top<1&&valid>20){const cut=Float32Array.from(B.A).sort()[Math.floor(valid*(1-cfg.top))],k=B.A.map(v=>v>=cut);for(const q in B)B[q]=B[q].filter((_,i)=>k[i])}
    const R=median(B.R),G=median(B.G),Bl=median(B.B),H=median(B.H)*2,Sa=median(B.S)/2.55,V=median(B.V)/2.55,a=median(B.A),rc=R/(R+G+Bl);
    const pallor=Math.round((1-(.6*norm(a,cfg.aMin,cfg.aMax)+.4*norm(rc,cfg.rMin,cfg.rMax)))*1000)/10;
    const gp=glare/seen*100,dp=dark/seen*100,vp=valid/seen*100;let lv=0;const issues=[];
    const fl=(l,t)=>{lv=Math.max(lv,l);issues.push(t)};
    if(gp>20)fl(2,"Strong reflections");else if(gp>8)fl(1,"Some reflections");
    if(dp>30)fl(2,"Too dark or shadowed");else if(dp>15)fl(1,"Partly in shadow");
    if(vp<40)fl(2,"Too little usable tissue in the box");else if(vp<60)fl(1,"Box includes white or shiny area");
    const rej=[];
    if(R-G<cfg.minRG)rej.push("Colour not red enough: the box may be on the wrong area or white balance is off");
    if(a<cfg.minA)rej.push("Redness (a*) too low");
    if(gp>15)rej.push("Too much glare");
    if(R<90||R>230)rej.push("Bad exposure");
    if(rej.length){lv=2;issues.unshift(...rej)}
    S.scans[kind]={kind,rgb:[R,G,Bl].map(Math.round),hsv:[Math.round(H),Math.round(Sa),Math.round(V)],a:+a.toFixed(1),pallor,level:lv,rejected:rej.length>0,issues,
      glare:Math.round(gp),shadow:Math.round(dp),usable:Math.round(vp),photo:cnv.toDataURL("image/jpeg",.6)};
    m.className="msg";m.textContent=rej.length?"Region rejected: it does not look like the right tissue. Retake.":"Analysis complete.";renderScan();
  }catch(err){console.error(err);m.textContent="OpenCV error: "+(err.message||err)}
  finally{[src,reg,rgb,hsv,lab].forEach(x=>{try{x&&x.delete()}catch(e){}})}
}
