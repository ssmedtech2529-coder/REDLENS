  const irow=(k,nm)=>{const x=feat.find(f=>f.kind===k);return`<tr><td>${nm}</td><td>${x?(x.rejected?"Region rejected – retake":d(r[k]))+` · RGB ${x.rgb.join(",")} · HSV ${x.hsv.join(",")}`:"Not scanned"}</td><td>${x?(x.rejected?"Rejected":"Completed"):"Not performed"}</td></tr>`};
