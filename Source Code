const sigmoid=x=>1/(1+Math.exp(-x));
const RISK=[
  {max:20,name:"Very Low Risk",col:"#1a7f4b",bg:"#e4f5ec",txt:"This pattern is unlikely to be anaemia."},
  {max:40,name:"Low Risk",col:"#4d8f1d",bg:"#eef8dc",txt:"Anaemia is unlikely, but re-screen if symptoms such as tiredness or dizziness appear."},
  {max:60,name:"Moderate Risk",col:"#8a6d00",bg:"#fff6c4",txt:"Anaemia is possible. A laboratory Hb test is advised to confirm."},
  {max:80,name:"High Risk",col:"#c2570c",bg:"#ffe6cf",txt:"Anaemia is likely. Please get a laboratory Hb test soon."},
  {max:100,name:"Very High Risk",col:"#b42318",bg:"#fde8e6",txt:"Anaemia is very likely. Please see a health professional and get a laboratory Hb test as soon as possible."}];
const riskOf=pr=>RISK.find(r=>pr<=r.max)||RISK[RISK.length-1];
const MSG_FAIL="Image consistency failed. Please retake the fingernail and lower eyelid images.";
const MSG_FAIL2="The two Hb values are not consistent. Please retake the images for a new analysis.";
const MSG_OK="Result is consistent. Proceed to the next step.";
function screenProb(p,scans,vit){
  const n=scans.nail,e=scans.eye;
  if(!n||!e)return{status:"incomplete",msg:"Complete both image checks (fingernail and lower eyelid) to get the probability score."};
  if([n,e].some(s=>s.rejected||s.level===2||!isFinite(s.pallor)))return{status:"quality",msg:"One or both images have insufficient quality. Please retake the fingernail and lower eyelid images."};
  const hb1=hbFromPallor(n.pallor),hb2=hbFromPallor(e.pallor);
  const diff=Math.round(Math.abs(hb1-hb2)*10)/10;
  if(!hbDiffOk(diff))return{status:"fail",hb1,hb2,diff,msg:MSG_FAIL,detail:MSG_FAIL2};
  const hb=Math.round((hb1+hb2)/2*10)/10,thr=p?whoCuts(p)[0]:12;
  /* 1) Hb is the primary factor: logistic centred just below the WHO anaemia cut-off */
  let z=(thr-0.5-hb)/0.9;
  /* 2) image agreement: closer Hb estimates -> more confident; lower image quality -> less confident */
  z*=(1+0.15*(1-clamp(diff/HB_TOL,0,1)))*((n.level===0&&e.level===0)?1:0.9);
  /* 3) optional MAX30102 pulse and SpO2 (small, capped adjustment) */
  let adj=0;const notes=[];
  if(vit&&vit.hr!=null&&vit.hr>=30&&vit.hr<=220){
    if(vit.hr>100){adj+=0.6;notes.push(`Pulse ${vit.hr} bpm is high, which can go with anaemia and slightly raises the score.`)}
    else if(vit.hr>90){adj+=0.3;notes.push(`Pulse ${vit.hr} bpm is a little high and slightly raises the score.`)}
    else notes.push(`Pulse ${vit.hr} bpm is in the usual range.`)}
  if(vit&&vit.spo2!=null&&vit.spo2>=50&&vit.spo2<=100){
    if(vit.spo2<94){adj+=0.3;notes.push(`SpO₂ ${vit.spo2}% is low and slightly raises the score. Clinical review is advised.`)}
    else notes.push(`SpO₂ ${vit.spo2}% is normal.`)}
  adj=Math.min(adj,0.9);
  z=clamp(z+adj,-6,6);
  const prob=clamp(Math.round(sigmoid(z)*100),0,100),risk=riskOf(prob);
  const explain=`The estimated Hb is ${hb.toFixed(1)} g/dL (fingernail ${hb1.toFixed(1)}, lower eyelid ${hb2.toFixed(1)}), which is ${hb>=thr?"at or above":"below"} the reference of ${thr} g/dL for this patient. The two images agree within ${diff.toFixed(1)} g/dL. ${notes.join(" ")} ${risk.txt}`.replace(/\s+/g," ").trim();
  return{status:"ok",hb1,hb2,diff,hb,thr,prob,risk,notes,explain}
}
function probHTML(pr,rep){
