    <div><div style="font-size:12px;font-weight:700">Anaemia probability score</div><div style="font-size:28px;font-weight:800">${pr.prob}%</div></div>
    <div><div style="font-size:12px;font-weight:700">Risk level</div><div style="font-size:20px;font-weight:800">${esc(r.name)}</div></div></div>
   <div style="height:10px;background:rgba(0,0,0,.12);border-radius:6px;margin-top:10px;overflow:hidden"><div style="height:100%;width:${pr.prob}%;background:${r.col}"></div></div></div>
  <p><b>What this means:</b> ${esc(pr.explain)}</p><p class="${nc}">${disc}</p>`}
