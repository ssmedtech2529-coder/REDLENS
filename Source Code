  return{rid:S.rid||"–",centre:p?p.centre:"",by:p?p.by:"",hct:S.hct,nail:lab("nail"),eye:lab("eye"),light:lg,ref,id:p?p.id:"–",name:p?p.name:"–",age:p?p.age:null,gender:p?p.gender:"–",village:p?p.village:"",phone:p?p.phone:"",preg:p?p.preg:false,hist:p?p.hist:"–",symptoms:p?p.symptoms:[],
