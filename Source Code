    if(!x)return`<tr><td>Check ${n}</td><td>${nm}</td><td>–</td><td>–</td><td>Not done</td></tr>`;
    return`<tr><td>Check ${n}</td><td>${nm}</td><td>${x.rejected||x.pallor==null?"–":Math.round(x.pallor)+"/100"}</td><td>${esc(x.quality)}</td><td>${esc(r[k])}</td></tr>`};
  const good=feat.filter(f=>!f.rejected&&f.quality!=="Poor");
  const note=feat.length<2?"Only one check done. Do the second check (the other site) to confirm the result.":
    good.length<2?"One check had poor quality. Retake it for a reliable two-check result.":
    r.nail===r.eye?"Both checks give the same result.":"The two checks differ. Repeat in even daylight and confirm with a laboratory Hb test.";
  return`<div class="sec">Two-check summary</div><table><tr><th>Check</th><th>Site</th><th>Pallor score</th><th>Image quality</th><th>Result</th></tr>${row(1,"nail","Nail bed")}${row(2,"eye","Lower eyelid (conjunctiva)")}</table><p class="note">${note}</p>`}
