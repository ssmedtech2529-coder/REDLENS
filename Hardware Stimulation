  /* Result screen: exactly the layout from the specification. */
  DisplayController.prototype._complete = function (d, s) {
    var r = s.result;
    d.text(0, 0, s.name, 1);
    batteryLine(d, s, 8);
    d.text(0, 24, 'Hb: ' + r.hb.toFixed(1) + ' g/dL', 1);
    d.text(0, 32, 'HR: ' + Math.round(r.hr) + ' BPM', 1);
    d.text(0, 40, 'SpO2: ' + Math.round(r.spo2) + '%', 1);
    d.text(0, 48, 'Signal: ' + r.quality, 1);
    d.text(0, 56, 'Scan Complete', 1);
