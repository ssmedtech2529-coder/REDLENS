    h += '<rect class="bezel" x="668" y="58" width="264" height="136" rx="4"/>';
    ['GND', 'VCC', 'SCL', 'SDA'].forEach(function (t, k) {
      h += '<circle class="pin" cx="630" cy="' + (75 + 20 * k) + '" r="4"/><text class="pin-t sm" x="638" y="' + (78 + 20 * k) + '">' + t + '</text>';
    });
    h += '<text class="chip-t" x="800" y="216" text-anchor="middle">SSD1306 OLED 128\u00d764 \u00b7 I\u00b2C 0x3C</text>';
