    if (valid.length < need) { this._error(['Signal quality poor', 'Keep finger still', 'Retry scan'], now); return; }

    var est = this.estimator.estimate(valid);
    var meanQ = U.mean(valid.map(function (w) { return w.q; }));
    var quality = ns.qualityLabel(meanQ);
    if (quality === 'Poor') { this._error(['Signal quality poor', 'Keep finger still', 'Retry scan'], now); return; }

    var last = valid.slice(-10);
    var spo2s = last.map(function (w) { return w.spo2; }).filter(function (v) { return v; });
    var gt = this.sensor.getGroundTruth ? this.sensor.getGroundTruth() : null;
    var rec = {
      id: this.nextId++, ts: Date.now(),
      hb: U.round(est.hb, 1), sigma: U.round(est.sigma, 1),
      hr: Math.round(U.median(last.map(function (w) { return w.hr; }))),
      spo2: Math.round(U.clamp(U.median(spo2s), 90, 100)),
      quality: quality, qualityScore: Math.round(meanQ),
      stability: Math.round(U.mean(valid.map(function (w) { return w.stab; }))),
      piPct: U.round(U.mean(valid.map(function (w) { return w.pi; })), 2),
      snr: U.round(U.mean(valid.map(function (w) { return w.snr; })), 1),
      R: U.round(U.mean(valid.map(function (w) { return w.R; })), 3),
      clamped: est.clamped, battery: Math.floor(this.battery.pct), charging: this.battery.charging,
      windows: valid.length + '/' + total, durationS: C.scan.acquireMs / 1000,
      model: est.model, firmware: C.device.firmware,
      frontEnd: this.sensor.frontEndLabel ? this.sensor.frontEndLabel() : 'MAX30102',
      simRef: gt ? U.round(gt.hb, 1) : null, simContact: gt ? gt.contact : null,
      waveform: this.recent.map(function (v) { return U.round(v * 100, 3); }),
      synced: false,
    };
    this._p('[RESULT] id=' + rec.id + ' Hb=' + rec.hb.toFixed(1) + '+/-' + rec.sigma.toFixed(1) + ' g/dL HR=' + rec.hr +
            ' SpO2=' + rec.spo2 + ' Q=' + rec.quality + ' model=' + rec.model);
    this.lastRecord = rec;
    this.history.unshift(rec);
    if (this.history.length > C.scan.historyLimit) this.history.length = C.scan.historyLimit;
    rec.synced = this.ble.sendResult(rec, false);          // false -> stays queued on the device
    this.store.set('history', this.history);
    this.store.set('nextId', this.nextId);
    this._enter(S.COMPLETE, now);
  };

  /* After a (re)connection: push all stored scans to the phone. */
  Firmware.prototype._syncHistory = function () {
    var pending = this.history.filter(function (r) { return !r.synced; }).length;
    this.ble.sendHistory(this.history.slice().reverse(), pending);
    for (var i = 0; i < this.history.length; i++) this.history[i].synced = true;
    this.store.set('history', this.history);
  };

  /* Simulation stop button: cut power. */
  Firmware.prototype.powerOff = function (now) {
    if (this.state === S.OFF) return;
    this._p('[PWR] power off');
    this.sensor.end(); this.led.set('off', 'solid', 1000);
    this.state = S.OFF; this.stateStart = now;
    this.ble.sendTelemetry({ samples: [], status: this.status() });
    this.ble.stop();
  };

  /* Serial console commands (typed in the serial monitor). */
  Firmware.prototype.command = function (line) {
    var c = String(line).trim().toLowerCase();
    if (!c) return;
    this._p('> ' + c, 'in');
    if (this.state === S.OFF && c !== 'reboot') { this._p('device is off - type "reboot" or press Start simulation'); return; }
    switch (c.split(/\s+/)[0]) {
      case 'help': this._p('commands: help | scan | status | history | reboot'); break;
      case 'scan':
        if ([S.READY, S.COMPLETE, S.ERROR].indexOf(this.state) >= 0) this.pressButton();
        else this._p('busy: state=' + this.state);
        break;
      case 'status':
        this._p('state=' + this.state + ' battery=' + Math.floor(this.battery.pct) + '% (' + this.battery.voltage().toFixed(2) + ' V' +
                (this.battery.charging ? ', charging' : '') + ') ble=' + this.ble.state + ' stored_scans=' + this.history.length);
        break;
      case 'history':
        if (!this.history.length) this._p('no stored scans');
        this.history.slice(0, 5).forEach(function (r) {
          this._p('#' + r.id + ' Hb=' + r.hb.toFixed(1) + ' HR=' + r.hr + ' SpO2=' + r.spo2 + ' Q=' + r.quality);
        }, this);
        break;
      case 'reboot': this.powerOn(this.now); break;
      default: this._p('unknown command: ' + c + ' (try "help")');
    }
  };

  Firmware.prototype.clearHistory = function () {
    this.history = []; this.store.set('history', []);
  };

  /* ---- views of the internal state -------------------------------------- */
  /* Compact status sent over BLE with every telemetry frame. */
  Firmware.prototype.status = function () {
    var st = this.state, t = this.now - this.stateStart, P = C.scan, m = this.metrics, prog = 0;
    if (st === S.SETTLE) prog = U.clamp(t / P.settleMs, 0, 1);
    else if (st === S.ACQUIRE) prog = U.clamp(t / P.acquireMs, 0, 1);
    else if (st === S.PROCESS) prog = U.clamp(t / P.processMs, 0, 1);
    return {
      state: st, progress: prog, message: this.message, errorLines: this.errorLines,
      battery: { pct: this.battery.pct, charging: this.battery.charging, volt: this.battery.voltage() },
      contact: this.lastContact,
      metrics: { hr: m.hr, spo2: m.spo2, quality: m.quality, qualityScore: m.qualityScore, stability: m.stability,
                 piPct: m.piPct, snrDb: m.snrDb, R: m.R, beats: m.beats },
      provisional: this.provisional, lossCount: this.lossCount,
    };
  };

  /* Everything the OLED screens need. */
  Firmware.prototype.snapshot = function () {
    var s = this.status(), t = this.now - this.stateStart;
    return {
      now: this.now, state: this.state, stateTime: t,
      name: C.device.name, firmware: C.device.firmware,
      bootLog: this.bootLog, bootProgress: U.clamp(t / C.scan.bootMs, 0, 1),
      battery: s.battery, bleState: this.ble.state, progress: s.progress,
      live: { hr: s.metrics.hr, spo2: s.metrics.spo2, quality: s.metrics.quality, stability: s.metrics.stability },
      wave: this.recent, result: this.lastRecord, message: this.message, errorLines: this.errorLines,
    };
  };

  ns.Firmware = Firmware;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * report.js  -  Scan report export (self-contained HTML + CSV)
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util;

  function esc(s) {
    return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
  }
  function fmtDate(ts) {
    var d = new Date(ts);
    return d.getFullYear() + '-' + U.pad2(d.getMonth() + 1) + '-' + U.pad2(d.getDate()) + ' ' + ns.util.clockTime(d);
  }

  /* Inline SVG of the filtered PPG saved with the scan (values in % of DC). */
  function waveformSvg(wf) {
    if (!wf || wf.length < 2) return '';
    var w = 640, h = 120, min = Infinity, max = -Infinity, i;
    for (i = 0; i < wf.length; i++) { if (wf[i] < min) min = wf[i]; if (wf[i] > max) max = wf[i]; }
    var span = Math.max(max - min, 1e-6), pts = [];
    for (i = 0; i < wf.length; i++) {
      pts.push((i * w / (wf.length - 1)).toFixed(1) + ',' + (h - 8 - (wf[i] - min) / span * (h - 16)).toFixed(1));
    }
    return '<svg viewBox="0 0 ' + w + ' ' + h + '" width="100%" height="120" role="img" aria-label="Filtered PPG waveform">' +
      '<rect width="' + w + '" height="' + h + '" fill="#f5f7fa"/>' +
      '<polyline fill="none" stroke="#1f5fbf" stroke-width="1.6" points="' + pts.join(' ') + '"/></svg>';
  }

  var Report = {
    /* records: newest first. selected: the scan to feature (default newest). */
    buildHtml: function (records, selected) {
      var r = selected || records[0], C = ns.Config;
      var css =
        'body{font:14px/1.5 "IBM Plex Sans",system-ui,sans-serif;color:#1b2733;margin:0;padding:32px;max-width:820px}' +
        'h1{font-size:22px;margin:0 0 2px;color:#0f3a7a}h2{font-size:15px;margin:26px 0 8px;color:#0f3a7a}' +
        '.sub{color:#5b6b7c;margin:0 0 18px}.notice{border-left:4px solid #1f5fbf;background:#eef4fc;padding:10px 14px;margin:16px 0}' +
        '.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid #dde3ea}' +
        '.grid div{padding:12px 14px;border-right:1px solid #dde3ea}.grid div:last-child{border-right:0}' +
        '.grid b{display:block;font-size:24px;color:#0f3a7a}.grid span{color:#5b6b7c;font-size:12px}' +
        'table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #dde3ea}' +
        'th{color:#5b6b7c;font-weight:500}dl{display:grid;grid-template-columns:200px 1fr;gap:4px 12px;margin:0}dt{color:#5b6b7c}dd{margin:0}' +
        '@media print{body{padding:0}}';
      var h = '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Hb research report</title><style>' + css + '</style></head><body>';
      h += '<h1>' + esc(C.device.name) + ' - scan report</h1>';
      h += '<p class="sub">Generated ' + esc(fmtDate(Date.now())) + ' &middot; firmware ' + esc(C.device.firmware) + ' &middot; simulation</p>';
      h += '<div class="notice"><strong>Research and educational simulation.</strong> ' + esc(C.safety) + '</div>';
      if (r) {
        h += '<h2>Scan #' + r.id + ' &middot; ' + esc(fmtDate(r.ts)) + '</h2>';
        h += '<div class="grid">' +
          '<div><b>' + r.hb.toFixed(1) + '</b><span>Estimated Hb (g/dL) &plusmn;' + r.sigma.toFixed(1) + '</span></div>' +
          '<div><b>' + r.hr + '</b><span>Heart rate (BPM)</span></div>' +
          '<div><b>' + r.spo2 + '</b><span>SpO&#8322; (%)</span></div>' +
          '<div><b>' + esc(r.quality) + '</b><span>Signal quality (' + r.qualityScore + '/100)</span></div></div>';
        h += '<h2>Filtered PPG (last 8 s)</h2>' + waveformSvg(r.waveform);
        h += '<h2>Processing details</h2><dl>' +
          '<dt>Signal stability</dt><dd>' + r.stability + ' %</dd>' +
          '<dt>Perfusion index</dt><dd>' + r.piPct + ' %</dd>' +
          '<dt>SNR</dt><dd>' + r.snr + ' dB</dd>' +
          '<dt>Red/IR ratio R</dt><dd>' + r.R + '</dd>' +
          '<dt>Usable windows</dt><dd>' + esc(r.windows) + ' (1 s each)</dd>' +
          '<dt>Calibration model</dt><dd>' + esc(r.model) + '</dd>' +
          '<dt>Optical front-end</dt><dd>' + esc(r.frontEnd) + '</dd>' +
          '<dt>Battery at scan</dt><dd>' + r.battery + ' %</dd>' +
          (r.simRef !== null && r.simRef !== undefined
            ? '<dt>Simulated reference Hb</dt><dd>' + r.simRef.toFixed(1) + ' g/dL (virtual subject; error ' +
              (r.hb - r.simRef >= 0 ? '+' : '') + (r.hb - r.simRef).toFixed(1) + ')</dd>' : '') +
          '</dl>';
      } else {
        h += '<p>No scans recorded yet.</p>';
      }
      h += '<h2>Scan history</h2><table><thead><tr><th>#</th><th>Time</th><th>Hb (g/dL)</th><th>HR</th><th>SpO&#8322;</th><th>Quality</th><th>Sim. ref</th></tr></thead><tbody>';
      records.forEach(function (x) {
        h += '<tr><td>' + x.id + '</td><td>' + esc(fmtDate(x.ts)) + '</td><td>' + x.hb.toFixed(1) + ' &plusmn; ' + x.sigma.toFixed(1) +
          '</td><td>' + x.hr + '</td><td>' + x.spo2 + '</td><td>' + esc(x.quality) + '</td><td>' +
          (x.simRef !== null && x.simRef !== undefined ? x.simRef.toFixed(1) : '-') + '</td></tr>';
      });
      h += '</tbody></table>';
      h += '<div class="notice"><strong>Safety notice.</strong> ' + esc(C.safety) + '</div></body></html>';
      return h;
    },

    buildCsv: function (records) {
      var rows = [['id', 'timestamp', 'hb_g_dL', 'hb_sigma', 'hr_bpm', 'spo2_pct', 'quality', 'quality_score',
                   'stability_pct', 'perfusion_index_pct', 'snr_db', 'R_ratio', 'sim_reference_hb', 'model', 'front_end']];
      records.slice().reverse().forEach(function (r) {
        rows.push([r.id, new Date(r.ts).toISOString(), r.hb, r.sigma, r.hr, r.spo2, r.quality, r.qualityScore,
                   r.stability, r.piPct, r.snr, r.R, r.simRef === null || r.simRef === undefined ? '' : r.simRef, r.model, r.frontEnd]);
      });
      return rows.map(function (row) {
        return row.map(function (c) { return '"' + String(c).replace(/"/g, '""') + '"'; }).join(',');
      }).join('\n');
    },

    download: function (filename, text, mime) {
      var blob = new Blob([text], { type: mime }), url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = filename; document.body.appendChild(a); a.click();
      setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(url); }, 500);
    },
  };

  ns.Report = Report;
})(window.HbSim);

</script>
