    this.buf = [];
    this.port = null;
    this.fingerTarget = false;
  }
  WebSerialSensor.prototype.connect = async function () {
    this.port = await navigator.serial.requestPort();
    await this.port.open({ baudRate: 115200 });
    var self = this, decoder = new TextDecoderStream();
    this.port.readable.pipeTo(decoder.writable);
    var reader = decoder.readable.getReader(), rest = '';
    (async function loop() {
      for (;;) {
        var r = await reader.read();
        if (r.done) break;
        var lines = (rest + r.value).split('\n'); rest = lines.pop();
        for (var i = 0; i < lines.length; i++) {
          var p = lines[i].trim().split(',');
          var red = parseInt(p[0], 10), ir = parseInt(p[1], 10);
          if (self.active && isFinite(red) && isFinite(ir)) self.buf.push({ t: ns.clock.now, red: red, ir: ir });
        }
      }
    })();
  };
  WebSerialSensor.prototype.begin = function () { this.active = true; this.buf = []; };
  WebSerialSensor.prototype.end = function () { this.active = false; };
  WebSerialSensor.prototype.pull = function () { var o = this.buf; this.buf = []; return o; };
  WebSerialSensor.prototype.setFingerPresent = function () { /* a real finger does this */ };
  WebSerialSensor.prototype.setOptions = function () {};
  WebSerialSensor.prototype.injectMotion = function () {};
  WebSerialSensor.prototype.frontEndLabel = function () { return 'MAX30102 (serial)'; };
  WebSerialSensor.prototype.getGroundTruth = function () { return null; };
  WebSerialSensor.prototype.isFingerPresent = function () { return false; };
  WebSerialSensor.prototype.getCoupling = function () { return 0; };

  ns.sensors = { SimulatedMAX30102: SimulatedMAX30102, WebSerialSensor: WebSerialSensor };
})(window.HbSim);

