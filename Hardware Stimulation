    h += '<rect class="outline" x="198" y="428" width="146" height="46" rx="9"/>';
    h += '<rect class="comp" x="210" y="432" width="120" height="38" rx="6"/>';
    h += '<circle class="bz-body" cx="238" cy="451" r="13"/><circle class="bz-hole" cx="238" cy="451" r="3"/>';
    h += '<g id="bz-waves" class="bzw"><path d="M258 443 a10 10 0 0 1 0 16"/><path d="M265 438 a17 17 0 0 1 0 26"/><path d="M272 433 a24 24 0 0 1 0 36"/></g>';
    h += '<text class="chip-t dk" x="318" y="466" text-anchor="end">Buzzer D14</text>';
    h += '</g>';

    /* ---------------- push button ---------------- */
    h += '<g class="part" data-part="btn">';
    h += '<rect class="outline" x="198" y="470" width="146" height="48" rx="9"/>';
    h += '<rect class="comp" x="210" y="476" width="120" height="36" rx="6"/>';
    h += '<g id="btn-cap" class="cap-g"><circle class="cap-ring" cx="244" cy="494" r="14"/><circle class="cap" cx="244" cy="494" r="10"/></g>';
    h += '<text class="chip-t dk" x="318" y="506" text-anchor="end">Start scan D13</text>';
    h += '</g>';
    h += gnd(330, 498, 'r');

    /* BLE antenna wave / phone hint */
    h += '</svg>';
    return h;
  }

  /* ======================================================================
   * CircuitView
   * ==================================================================== */
  function CircuitView(d) {
    this.d = d;                                   // { fw, sensor, user, battery, led, buzzer, ble }
    this.wrap = document.getElementById('circuit-wrap');
    this.wrap.innerHTML = buildSvg() +
      '<canvas id="oled" aria-label="SSD1306 OLED display, 128 by 64 pixels"></canvas>';
    this.svg = document.getElementById('circuit');
    var q = function (id) { return document.getElementById(id); };
    this.el = {
      dome: q('led-dome'), pwr: q('esp-pwr'), ble: q('ble-waves'), bz: q('bz-waves'), finger: q('finger'),
      fingerHint: q('finger-hint'), cap: q('btn-cap'), modMax: q('mod-max'), modAfe: q('mod-afe'), maxLabel: q('max-label'),
      pct: q('batt-pct'), bolt: q('batt-bolt'),
      seg: [0, 1, 2, 3, 4].map(function (i) { return q('bseg' + i); }),
      flow: {}, opt: [q('opt-red'), q('opt-ir'), q('opt-red2'), q('opt-ir2')],
    };
    ['sda', 'sdab', 'scl', 'sclb', 'r', 'g', 'b', 'buz', 'btn'].forEach(function (k) { this.el.flow[k] = q('fl-' + k); }, this);
    this.pressUntil = 0; this.selected = 'max'; this.onSelect = null;
    this._bind();
    this.select('max');
  }

  CircuitView.prototype._bind = function () {
    var self = this, d = this.d;
    this.svg.addEventListener('click', function (e) {
      var part = e.target.closest ? e.target.closest('.part') : null;
      if (e.target.closest && e.target.closest('#finger-hit')) { d.user.toggleFinger(); self.select('max'); return; }
      if (part) {
        var id = part.getAttribute('data-part');
        self.select(id);
        if (id === 'btn') { self.press(); }
      }
    });
    this.svg.addEventListener('keydown', function (e) { if (e.key === 'Enter' && self.selected === 'btn') self.press(); });
  };

  CircuitView.prototype.press = function () {
    this.pressUntil = performance.now() + 160;
    this.d.fw.pressButton();
  };

  CircuitView.prototype.select = function (id) {
    this.selected = id;
    var parts = this.svg.querySelectorAll('.part');
    for (var i = 0; i < parts.length; i++) {
      parts[i].classList.toggle('sel', parts[i].getAttribute('data-part') === id);
    }
    if (this.onSelect) this.onSelect(id);
  };

  function setFlow(el, on, slow) {
    if (!el) return;
    var cls = 'flow' + (on ? ' on' : '') + (slow ? ' slow' : '');
    if (el.getAttribute('class') !== cls) el.setAttribute('class', cls);
  }

  CircuitView.prototype.update = function (snap) {
    var d = this.d, e = this.el, now = ns.clock.now, st = snap.state, off = st === S.OFF;

    // power LED + sensor option
    e.pwr.setAttribute('class', 'pwr' + (off ? '' : ' on'));
    var afe = d.sensor.options && d.sensor.options.frontEnd === 'afe4404';
    e.modMax.style.display = afe ? 'none' : ''; e.modAfe.style.display = afe ? '' : 'none';
    e.maxLabel.textContent = afe ? 'BPW34 + AFE4404 (external front-end)' : 'MAX30102 optical sensor';

    // I2C wires: display bus always when powered, sensor branches while sampling
    var sampling = d.sensor.active && !off;
    setFlow(e.flow.sda, !off, true); setFlow(e.flow.scl, !off, true);
    setFlow(e.flow.sdab, sampling); setFlow(e.flow.sclb, sampling);

    // RGB LED + its three channel wires
    var c = d.led.get(now), dome = e.dome;
    if (c.a <= 0) { dome.style.fill = '#aeb9c6'; dome.style.filter = 'none'; }
    else {
      dome.style.fill = 'rgb(' + c.r + ',' + c.g + ',' + c.b + ')';
      dome.style.opacity = (0.45 + 0.55 * c.a).toFixed(2);
      dome.style.filter = 'drop-shadow(0 0 ' + Math.round(10 * c.a) + 'px rgba(' + c.r + ',' + c.g + ',' + c.b + ',.9))';
    }
    if (c.a <= 0) dome.style.opacity = 1;
    var on = c.a > 0.2;
    setFlow(e.flow.r, on && c.r / 255 > 0.45); setFlow(e.flow.g, on && c.g / 255 > 0.45); setFlow(e.flow.b, on && c.b / 255 > 0.45);

    // buzzer
    var bz = d.buzzer.isActive();
    e.bz.setAttribute('class', 'bzw' + (bz ? ' on' : ''));
    setFlow(e.flow.buz, bz);

    // button
    var pressed = performance.now() < this.pressUntil;
    e.cap.setAttribute('class', 'cap-g' + (pressed ? ' down' : ''));
    setFlow(e.flow.btn, pressed);

    // BLE radio
    var bs = d.ble.state;
    e.ble.setAttribute('class', 'ble' + (bs === 'connected' ? ' on' : bs === 'off' ? '' : ' adv'));

    // finger + optical emitters
    var down = d.sensor.isFingerPresent();
    var fc = 'finger' + (down ? ' down' : '') + (st === S.PLACE && !down ? ' hint' : '');
    if (e.finger.getAttribute('class') !== fc) e.finger.setAttribute('class', fc);
    e.fingerHint.setAttribute('class', 'hint-t' + (st === S.PLACE && !down ? ' on' : ''));
    e.fingerHint.textContent = snap.message && st === S.PLACE ? snap.message : 'Place finger';
    var lit = sampling && d.sensor.getCoupling() > 0.5;
    this.svg.setAttribute('class', lit ? 'lit' : '');
    if (lit) {
      var r = d.fw.recent, n = Math.min(r.length, 60), amp = 1e-4, i;
      for (i = r.length - n; i < r.length; i++) amp = Math.max(amp, Math.abs(r[i]));
      var v = n ? r[r.length - 1] : 0;
      this.svg.style.setProperty('--pulse', U.clamp(0.5 + v / (2 * amp), 0, 1).toFixed(2));
    }
    for (i = 0; i < e.opt.length; i++) e.opt[i].classList.toggle('emit', sampling);

    // battery
    var pct = d.battery.pct, segsOn = Math.ceil(pct / 20);
    for (i = 0; i < 5; i++) e.seg[i].setAttribute('class', 'seg' + (i < segsOn ? (pct < 15 ? ' low' : ' on') : ''));
    var pt = Math.floor(pct) + '%'; if (e.pct.textContent !== pt) e.pct.textContent = pt;
    e.bolt.setAttribute('class', 'bolt' + (d.battery.charging ? ' on' : ''));

    // OLED canvas keeps its own pixels; only the selection ring changes via CSS
  };

  ns.CircuitView = CircuitView;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * workbench.js  -  Simulator chrome: toolbar, tabs, serial monitor, inspector
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util, S = ns.Firmware.States;

  function $(id) { return document.getElementById(id); }
  function setText(el, t) { if (el && el.textContent !== t) el.textContent = t; }
  function toast(msg) {
    var t = $('toast'); t.textContent = msg; t.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(function () { t.classList.remove('show'); }, 2600);
  }
  ns.toast = toast;

  function fmtSim(ms) {
    var s = Math.max(0, ms) / 1000, m = Math.floor(s / 60);
    return U.pad2(m) + ':' + (s % 60 < 10 ? '0' : '') + (s % 60).toFixed(1);
  }

  /* ---- Toolbar: start/stop, restart, speed, simulated time ------------------ */
  function Toolbar(d) {
    this.d = d; var self = this;
    this.btn = $('btn-power');
    this.btn.addEventListener('click', function () {
      if (d.fw.state === S.OFF) d.fw.powerOn(ns.clock.now); else d.fw.powerOff(ns.clock.now);
    });
    $('btn-reboot').addEventListener('click', function () { d.fw.powerOn(ns.clock.now); });
    $('ctl-speed').addEventListener('change', function (e) { ns.clock.scale = parseFloat(e.target.value); });
    this.pill = $('sim-pill');
  }
  Toolbar.prototype.update = function (snap) {
    var off = snap.state === S.OFF;
    this.btn.classList.toggle('stop', !off);
    setText(this.btn.lastElementChild, off ? 'Start simulation' : 'Stop simulation');
    this.pill.className = 'pill ' + (off ? 'off' : 'run');
    setText(this.pill.lastElementChild, off ? 'Stopped' : 'Running');
    setText($('sim-time'), fmtSim(ns.clock.now));
  };

  /* ---- Tabs (serial monitor / oscilloscope / Bluetooth log) ---------------- */
  function Tabs() {
    var tabs = document.querySelectorAll('.tab'), panes = document.querySelectorAll('.pane');
    Array.prototype.forEach.call(tabs, function (t) {
      t.addEventListener('click', function () {
        Array.prototype.forEach.call(tabs, function (x) { x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
        Array.prototype.forEach.call(panes, function (p) { p.hidden = p.id !== 'pane-' + t.dataset.tab; });
      });
    });
  }

  /* ---- Serial monitor ------------------------------------------------------- */
  function SerialMonitor(d) {
    this.d = d; this.lines = []; this.dirty = false; this.pre = $('serial-out'); this.stick = true;
    var self = this;
    d.serial.on(function (l) { self.add(l.t, l.text, l.kind); });
    d.ble.on('log', function (l) { self.add(ns.clock.now, '[BLE] ' + (l.dir === 'app' ? 'app: ' : '') + l.msg, 'ble'); });
    this.pre.addEventListener('scroll', function () {
      self.stick = self.pre.scrollTop + self.pre.clientHeight >= self.pre.scrollHeight - 12;
    });
    $('serial-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var inp = $('serial-in'); d.fw.command(inp.value); inp.value = '';
    });
    $('serial-clear').addEventListener('click', function () { self.lines = []; self.dirty = true; });
  }
  SerialMonitor.prototype.add = function (t, text, kind) {
    var s = (t / 1000).toFixed(3);
    this.lines.push('<span class="ts">[' + ('       ' + s).slice(-8) + ']</span> <span class="' + (kind || 'out') + '">' +
      text.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</span>');
    if (this.lines.length > 400) this.lines.shift();
    this.dirty = true;
  };
  SerialMonitor.prototype.flush = function () {
    if (!this.dirty) return;
    this.dirty = false;
    this.pre.innerHTML = this.lines.join('\n');
    if (this.stick) this.pre.scrollTop = this.pre.scrollHeight;
  };

  /* ---- Inspector: properties of the selected part --------------------------- */
  function Inspector(d, circuit) {
    this.d = d; this.circuit = circuit; this.part = 'max';
    var self = this;
    circuit.onSelect = function (id) { self.show(id); };

    $('ctl-subject').addEventListener('change', function (e) { d.sensor.setOptions({ subject: e.target.value }); });
    $('ctl-contact').addEventListener('change', function (e) { d.sensor.setOptions({ contact: e.target.value }); });
    $('ctl-frontend').addEventListener('change', function (e) {
      d.sensor.setOptions({ frontEnd: e.target.value });
      toast('Swapped optical front-end. Takes effect on the next scan.');
    });
    $('ctl-finger').addEventListener('change', function (e) { d.user.mode = e.target.value; });
    $('btn-finger').addEventListener('click', function () { d.user.toggleFinger(); });
    $('btn-shake').addEventListener('click', function () {
      if (d.sensor.isFingerPresent() && d.sensor.active) { d.user.shake(); toast('Motion artifact injected'); }
      else toast('Place a finger on the sensor first');
    });
    $('ctl-sound').addEventListener('change', function (e) { d.buzzer.muted = !e.target.checked; });
    $('ctl-batt').addEventListener('input', function (e) { d.battery.set(parseFloat(e.target.value)); });
    $('ctl-charge').addEventListener('change', function (e) { d.battery.charging = e.target.checked; });
    $('btn-press').addEventListener('click', function () { circuit.press(); });
    $('btn-ble-prop').addEventListener('click', function () { $('btn-ble').click(); });
  }

  Inspector.prototype.show = function (id) {
    this.part = id;
    var names = { esp32: 'ESP32 DevKit V1', oled: 'SSD1306 OLED', max: 'Optical sensor', led: 'RGB status LED', bz: 'Buzzer', btn: 'Push button', batt: 'Battery + charger' };
    setText($('prop-title'), names[id] || id);
    var secs = document.querySelectorAll('.prop-sec');
    for (var i = 0; i < secs.length; i++) secs[i].hidden = secs[i].dataset.part !== id;
  };

  function kv(id, pairs) {
    var el = $(id), html = '';
    pairs.forEach(function (p) { html += '<dt>' + p[0] + '</dt><dd>' + p[1] + '</dd>'; });
    if (el.innerHTML !== html) el.innerHTML = html;
  }

  Inspector.prototype.update = function (snap) {
    var d = this.d, st = snap.state, now = ns.clock.now;
    switch (this.part) {
      case 'esp32':
        kv('kv-esp32', [['State', st], ['Firmware', ns.Config.device.firmware], ['CPU', '240 MHz dual core'], ['Supply', '3.3 V'],
                        ['Stored scans', d.fw.history.length], ['Bluetooth', d.ble.state]]);
        break;
      case 'oled':
        kv('kv-oled', [['Controller', 'SSD1306'], ['Resolution', '128 \u00d7 64 mono'], ['Bus', 'I\u00b2C @ 0x3C'], ['Screen', st === S.OFF ? 'off' : st]]);
        break;
      case 'max':
        kv('kv-max', [['Part', d.sensor.frontEndLabel ? d.sensor.frontEndLabel() : 'MAX30102'], ['LEDs', 'Red 660 nm / IR 880 nm'],
                      ['ADC', ns.Config.sensor.adcBits + '-bit @ ' + ns.Config.sensor.fs + ' sps'],
                      ['Status', d.sensor.active ? 'sampling' : 'shutdown'], ['Finger', d.sensor.isFingerPresent() ? 'on sensor' : 'away']]);
        setText($('btn-finger'), d.sensor.isFingerPresent() ? 'Remove finger' : 'Place finger');
        break;
      case 'led':
        var c = d.led.get(now);
        kv('kv-led', [['Colour', c.a > 0 ? c.name : 'Off'], ['R (D25)', Math.round(c.r * c.a / 2.55) + ' %'], ['G (D26)', Math.round(c.g * c.a / 2.55) + ' %'], ['B (D27)', Math.round(c.b * c.a / 2.55) + ' %']]);
        break;
      case 'bz':
        kv('kv-bz', [['Drive', 'GPIO 14'], ['State', d.buzzer.muted ? 'muted (audio off)' : d.buzzer.isActive() ? 'beeping' : 'silent']]);
        break;
      case 'btn':
        kv('kv-btn', [['Input', 'GPIO 13, INPUT_PULLUP'], ['Level', performance.now() < this.circuit.pressUntil ? 'LOW (pressed)' : 'HIGH']]);
        break;
      case 'batt':
        kv('kv-batt', [['Charge', Math.floor(d.battery.pct) + ' %'], ['Voltage', d.battery.voltage().toFixed(2) + ' V'],
                       ['Charger', d.battery.charging ? 'USB connected' : 'not connected'], ['ADC pin', 'D34 via 100k/100k']]);
        var sl = $('ctl-batt'); if (document.activeElement !== sl) sl.value = Math.round(d.battery.pct);
        setText($('out-batt'), Math.floor(d.battery.pct) + '%');
        break;
      default: break;
    }
    var bs = d.ble.state;
    setText($('prop-ble'), bs === 'connected' ? 'Connected' : bs === 'connecting' ? 'Pairing' : bs === 'advertising' ? 'Advertising' : 'Off');
  };

  ns.Toolbar = Toolbar; ns.Tabs = Tabs; ns.SerialMonitor = SerialMonitor; ns.Inspector = Inspector;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * ui.js  -  User interface
 *
 *   Dashboard    the phone side: everything here arrives over the simulated
 *                Bluetooth link (telemetry, results, history sync).
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util, C = ns.Config, S = ns.Firmware.States;

  function $(id) { return document.getElementById(id); }
  function setText(el, txt) { if (el.textContent !== txt) el.textContent = txt; }
  function toast(msg) {
    var t = $('toast'); t.textContent = msg; t.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(function () { t.classList.remove('show'); }, 2600);
  }

  /* ======================================================================
   * Dashboard
   * ==================================================================== */
  var STEP_OF = { BOOT: 0, READY: 0, PLACE_FINGER: 1, SETTLING: 2, ACQUIRING: 3, PROCESSING: 4, COMPLETE: 5 };
  var STATE_CHIP = {
    BOOT: ['Starting', 'busy'], READY: ['Ready', 'ok'], PLACE_FINGER: ['Waiting for finger', 'busy'],
    SETTLING: ['Detecting pulse', 'busy'], ACQUIRING: ['Measuring', 'busy'], PROCESSING: ['Estimating', 'busy'],
    COMPLETE: ['Scan complete', 'ok'], ERROR: ['Needs attention', 'bad'], OFF: ['Off', ''],
  };
  var Q_COLORS = ['#d64545', '#d98e04', '#1f5fbf', '#1e9e6a'];
  var Q_LEVEL = { Poor: 1, Fair: 2, Good: 3, Excellent: 4 };
  var CONTACT_TXT = { none: 'No finger', settling: 'Settling', stable: 'Good contact', lost: 'Lost' };
  var BUF = 300;                                   // 6 s at 50 Hz

  function Dashboard(d) {
    this.d = d;                                    // { ble, fw, store }
    this.red = []; this.ir = []; this.f = [];
    this.status = null; this.lastSampleAt = 0;
    this.records = []; this.userDisconnected = false;
    this.lastState = ''; this.lastGoodStep = 0; this.liveMsg = '';
    this.cv = $('wave'); this.ctx = this.cv.getContext('2d');
    this.lanes = [
      { key: 'red', label: 'Raw red \u00b7 660 nm', color: '#c0392b', lo: null, hi: null },
      { key: 'ir', label: 'Raw IR \u00b7 880 nm', color: '#6b7a8c', lo: null, hi: null },
      { key: 'f', label: 'Filtered PPG', color: '#1f5fbf', lo: null, hi: null },
    ];
    this.selected = null; this.reportHtml = '';
    this.logLines = [];
    $('safety-text').textContent = C.safety;
    $('foot-safety').textContent = C.safety;
    this._bindBle(); this._bindUi();
  }

  Dashboard.prototype._bindBle = function () {
    var self = this, ble = this.d.ble;
    ble.on('telemetry', function (fr) { self._onTelemetry(fr); });
    ble.on('result', function (e) {
      self._addRecord(e.record);
      toast('Scan #' + e.record.id + ' received over Bluetooth \u00b7 CRC ' + (e.packet.crcOk ? 'ok' : 'error'));
    });
    ble.on('history', function (list) {
      list.forEach(function (r) { self._addRecord(r, true); });
      self._renderHistory();
      if (list.length) toast('Synced ' + list.length + ' stored scan' + (list.length > 1 ? 's' : ''));
    });
    ble.on('log', function (l) { self._log(l); });
    ble.on('state', function (s) {
      self._renderBleControls();
      if (s === 'advertising' && !self.userDisconnected) {
        setTimeout(function () { if (ble.state === 'advertising' && !self.userDisconnected) ble.requestConnect(); }, 1200);
      }
    });
  };

  Dashboard.prototype._bindUi = function () {
    var self = this, ble = this.d.ble;
    $('btn-ble').addEventListener('click', function () {
      if (ble.state === 'connected') { self.userDisconnected = true; ble.disconnect(); }
      else if (ble.state === 'advertising') { self.userDisconnected = false; ble.requestConnect(); }
    });
    $('btn-export').addEventListener('click', function () {
      if (!self.records.length) { toast('No scans to export yet'); return; }
      self._openReport(null);
    });
    $('btn-clear').addEventListener('click', function () {
      var b = $('btn-clear');
      if (b.dataset.arm === '1') {
        clearTimeout(self._armT); b.dataset.arm = '0'; b.textContent = 'Clear history';
        self.records = []; self.d.fw.clearHistory(); self._renderHistory(); toast('History cleared');
      } else {
        b.dataset.arm = '1'; b.textContent = 'Confirm clear';
        self._armT = setTimeout(function () { b.dataset.arm = '0'; b.textContent = 'Clear history'; }, 3000);
      }
    });
    $('hist-body').addEventListener('click', function (e) {
      var tr = e.target.closest('li'); if (!tr) return;
      var id = parseInt(tr.dataset.id, 10);
      var rec = self.records.filter(function (r) { return r.id === id; })[0];
      if (rec) self._openReport(rec);
    });
    $('rep-close').addEventListener('click', function () { $('modal').hidden = true; });
    $('modal').addEventListener('click', function (e) { if (e.target === $('modal')) $('modal').hidden = true; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') $('modal').hidden = true; });
    $('rep-html').addEventListener('click', function () {
      var id = self.selected ? self.selected.id : (self.records[0] || {}).id;
      ns.Report.download('hb-research-report-scan-' + id + '.html', self.reportHtml, 'text/html');
    });
    $('rep-csv').addEventListener('click', function () {
      ns.Report.download('hb-research-scan-history.csv', ns.Report.buildCsv(self.records), 'text/csv');
    });
    $('rep-print').addEventListener('click', function () {
      try { var w = $('rep-frame').contentWindow; w.focus(); w.print(); }
      catch (e) { toast('Printing is unavailable here. Use Download report instead.'); }
    });
    window.addEventListener('resize', function () { self._fitCanvas(true); });
  };

  /* ---- data in ---------------------------------------------------------- */
  Dashboard.prototype._onTelemetry = function (fr) {
    var st = fr.status;
    // a new scan begins -> clear the old trace
    if (st.state === S.PLACE && this.lastState !== S.PLACE && this.lastState !== '' && !st.lossCount) {
      this.red.length = 0; this.ir.length = 0; this.f.length = 0;
    }
    this.lastState = st.state; this.status = st;
    var s = fr.samples;
    if (s.length) {
      for (var i = 0; i < s.length; i++) { this.red.push(s[i].red); this.ir.push(s[i].ir); this.f.push(s[i].f); }
      this.lastSampleAt = performance.now();
      if (this.red.length > BUF + 40) {
        var cut = this.red.length - BUF;
        this.red.splice(0, cut); this.ir.splice(0, cut); this.f.splice(0, cut);
      }
    }
  };

  Dashboard.prototype._addRecord = function (rec, quiet) {
    var copy = JSON.parse(JSON.stringify(rec));          // the phone owns its own copy
    var idx = -1;
    for (var i = 0; i < this.records.length; i++) if (this.records[i].id === copy.id) idx = i;
    if (idx >= 0) this.records[idx] = copy; else this.records.push(copy);
    this.records.sort(function (a, b) { return b.id - a.id; });
    if (this.records.length > C.scan.historyLimit) this.records.length = C.scan.historyLimit;
    if (!quiet) this._renderHistory();
  };

  Dashboard.prototype._log = function (l) {
    var t = ns.util.clockTime(l.t), who = l.dir === 'app' ? 'App    ' : 'Device ';
    this.logLines.push('[' + t + '] ' + who + l.msg + (l.hex ? '\n           ' + l.hex : ''));
    if (this.logLines.length > 80) this.logLines.shift();
    var el = $('ble-log'); el.textContent = this.logLines.join('\n'); el.scrollTop = el.scrollHeight;
  };

  /* ---- report modal ------------------------------------------------------ */
  Dashboard.prototype._openReport = function (rec) {
    this.selected = rec;
    this.reportHtml = ns.Report.buildHtml(this.records, rec || this.records[0]);
    $('rep-frame').srcdoc = this.reportHtml;
    $('modal').hidden = false;
  };

  /* ---- history table ----------------------------------------------------- */
  Dashboard.prototype._renderHistory = function () {
    var body = $('hist-body'), html = '';
    this.records.forEach(function (r) {
      html += '<li data-id="' + r.id + '"><span class="h-time">' + U.clockTime(new Date(r.ts)) + '</span>' +
        '<span class="h-hb">' + r.hb.toFixed(1) + '<small> g/dL</small></span>' +
        '<span class="h-vit">' + r.hr + ' BPM \u00b7 ' + r.spo2 + '%</span>' +
        '<span class="qtag ' + r.quality + '">' + r.quality + '</span></li>';
    });
    body.innerHTML = html;
    $('hist-empty').hidden = this.records.length > 0;
  };

  Dashboard.prototype._renderBleControls = function () {
    var s = this.d.ble.state, b = $('btn-ble');
    var txt = { off: 'Bluetooth off', advertising: 'Device found, not connected', connecting: 'Connecting\u2026', connected: 'Connected to HB-PROTO-01' }[s];
    setText($('ble-text'), txt);
    b.textContent = s === 'connected' ? 'Disconnect' : 'Connect';
    b.disabled = s === 'off' || s === 'connecting';
  };

  /* ---- per-frame render --------------------------------------------------- */
  Dashboard.prototype.render = function () {
    var st = this.status, ble = this.d.ble, connected = ble.state === 'connected';
    this._renderChips(st, connected);
    this._renderBleControls();
    if (!st) { this._drawWave(); return; }

    var state = st.state, step = STEP_OF[state];
    if (step !== undefined) this.lastGoodStep = step;
    this._renderStepper(st, step);
    this._renderReadout(st);

    var m = st.metrics, scanning = [S.SETTLE, S.ACQUIRE].indexOf(state) >= 0;
    setText($('m-stab'), scanning && m.beats >= 4 ? Math.round(m.stability) + ' %' : '--');
    setText($('m-pi'), scanning && m.beats >= 4 ? m.piPct.toFixed(2) + ' %' : '--');
    setText($('m-snr'), scanning && m.beats >= 4 ? m.snrDb.toFixed(1) + ' dB' : '--');
    setText($('m-r'), scanning && m.R ? m.R.toFixed(2) : '--');
    setText($('m-contact'), CONTACT_TXT[st.contact] || '--');

    // overlay
    var ov = $('wave-overlay'), msg = '', fresh = performance.now() - this.lastSampleAt < 900;
    if (!connected) msg = 'Bluetooth disconnected. Live data is paused. Scans taken now are stored on the device and sync when you reconnect.';
    else if (state === S.BOOT || state === S.READY) msg = 'Press Start scan on the device to begin.';
    else if (!fresh && this.f.length === 0) msg = 'Waiting for signal\u2026';
    setText(ov, msg || ov.textContent);
    ov.classList.toggle('hide', !msg);

    var label = (STATE_CHIP[state] || [state])[0];
    if (label !== this.liveMsg) { this.liveMsg = label; setText($('live'), 'Device status: ' + label); }
    this._drawWave();
  };

  Dashboard.prototype._renderChips = function (st, connected) {
    var cs = $('chip-state'), cb = $('chip-ble'), cbt = $('chip-batt');
    var info = !st ? ['Starting', 'busy'] : !connected ? ['No data link', 'warn'] : (STATE_CHIP[st.state] || ['--', '']);
    cs.className = 'chip ' + info[1]; setText(cs.lastElementChild, info[0]);
    var bs = this.d.ble.state;
    var bi = { connected: ['Bluetooth connected', 'ok'], connecting: ['Connecting\u2026', 'busy'], advertising: ['Bluetooth advertising', 'warn'], off: ['Bluetooth off', ''] }[bs];
    cb.className = 'chip ' + bi[1]; setText(cb.lastElementChild, bi[0]);
    if (st) {
      var pct = st.battery.pct;
      setText($('chip-batt-text'), Math.floor(pct) + '%' + (st.battery.charging ? ' charging' : ''));
      $('chip-batt-fill').setAttribute('width', (19 * U.clamp(pct, 0, 100) / 100).toFixed(1));
      cbt.classList.toggle('low', pct < 15);
    }
  };

  Dashboard.prototype._renderStepper = function (st, step) {
    var lis = $('stepper').querySelectorAll('li'), state = st.state, cur = step === undefined ? this.lastGoodStep : step;
    for (var i = 0; i < lis.length; i++) {
      var cls = '';
      if (state === S.COMPLETE) cls = i < 5 ? 'done' : 'done now';
      else if (state === S.ERROR) cls = i < cur ? 'done' : i === cur ? 'err' : '';
      else cls = i < cur ? 'done' : i === cur ? 'now' : '';
      if (lis[i].className !== cls) lis[i].className = cls;
    }
    var frac = (state === S.SETTLE || state === S.ACQUIRE || state === S.PROCESS) ? st.progress : 0;
    var pct = state === S.COMPLETE ? 1 : U.clamp((cur + frac) / 5, 0, 1);
    $('stepper-fill').style.width = (84 * pct).toFixed(1) + '%';
  };

  Dashboard.prototype._renderReadout = function (st) {
    var state = st.state, m = st.metrics, rec = this.records[0] || null;
    var hbEl = $('hb-val'), sub = $('hb-sub'), mark = $('range-mark');
    var hb = null, prov = false, subTxt = 'Demonstration estimate only';

    if (state === S.COMPLETE && rec) { hb = rec.hb; subTxt = 'Estimate \u00b1' + rec.sigma.toFixed(1) + ' g/dL (1\u03c3) \u00b7 demonstration only'; }
    else if (state === S.COMPLETE) { subTxt = 'Result is stored on the device and will sync on reconnect'; }
    else if ((state === S.ACQUIRE || state === S.PROCESS) && st.provisional) { hb = st.provisional.hb; prov = true; subTxt = 'Provisional \u00b7 still refining'; }
    else if ([S.PLACE, S.SETTLE, S.ACQUIRE, S.PROCESS].indexOf(state) >= 0) { subTxt = 'Measuring\u2026'; }
    else if (state === S.ERROR) { subTxt = 'No result for this scan'; }
    else if (rec) { hb = rec.hb; subTxt = 'Last scan \u00b7 ' + U.clockTime(new Date(rec.ts)) + ' \u00b7 demonstration only'; }

    setText(hbEl, hb === null ? '--.-' : hb.toFixed(1));
    hbEl.classList.toggle('prov', prov);
    setText(sub, subTxt);
    if (hb === null) mark.style.opacity = 0;
    else {
      mark.style.opacity = prov ? 0.45 : 1;
      mark.style.left = (U.clamp((hb - C.hbRange.min) / (C.hbRange.max - C.hbRange.min), 0, 1) * 100).toFixed(1) + '%';
    }

    // vitals
    var live = [S.SETTLE, S.ACQUIRE].indexOf(state) >= 0, hr = '--', sp = '--', q = '--', ql = 0;
    if (live) {
      if (m.hr && m.beats >= 3) hr = Math.round(m.hr);
      if (m.spo2 && m.beats >= 3) sp = Math.round(U.clamp(m.spo2, 90, 100));
      q = m.quality || 'Searching'; ql = Q_LEVEL[m.quality] || 0;
    } else if (state === S.PROCESS) {
      if (m.hr) hr = Math.round(m.hr); if (m.spo2) sp = Math.round(U.clamp(m.spo2, 90, 100));
      q = m.quality || '--'; ql = Q_LEVEL[m.quality] || 0;
    } else if (rec && (state === S.COMPLETE || state === S.READY || state === S.BOOT)) {
      hr = rec.hr; sp = rec.spo2; q = rec.quality; ql = Q_LEVEL[rec.quality];
    }
    setText($('hr-val'), String(hr)); setText($('spo2-val'), String(sp)); setText($('q-val'), q);
    var bars = $('qbar').children;
    for (var i = 0; i < 4; i++) bars[i].style.background = i < ql ? Q_COLORS[ql - 1] : '';

    // scan status
    var t = { main: 'Ready', sub: 'Press Start scan on the device', prog: 0 };
    switch (state) {
      case S.BOOT: t = { main: 'Starting', sub: 'Device is booting', prog: 0 }; break;
      case S.PLACE: t = { main: 'Waiting for finger', sub: st.message || 'Cover the sensor window with your fingertip', prog: 0 }; break;
      case S.SETTLE: t = { main: 'Detecting pulse', sub: 'Hold still', prog: st.progress }; break;
      case S.ACQUIRE: t = { main: 'Measuring', sub: Math.round(st.progress * 100) + '% \u00b7 ' + Math.max(0, Math.ceil((1 - st.progress) * C.scan.acquireMs / 1000)) + ' s left', prog: st.progress }; break;
      case S.PROCESS: t = { main: 'Estimating Hb', sub: 'Applying calibration model', prog: st.progress }; break;
      case S.COMPLETE: t = { main: 'Scan complete', sub: this.d.ble.state === 'connected' ? 'Saved to history' : 'Saved on device, waiting to sync', prog: 1 }; break;
      case S.ERROR: t = { main: 'Retry needed', sub: (st.errorLines || []).join(' \u00b7 '), prog: 0 }; break;
      default: break;
    }
    setText($('status-val'), t.main); setText($('status-sub'), t.sub);
    $('status-bar').style.width = (t.prog * 100).toFixed(0) + '%';
  };

  /* ---- waveform canvas ----------------------------------------------------- */
  Dashboard.prototype._fitCanvas = function (force) {
    var cv = this.cv, dpr = window.devicePixelRatio || 1;
    var w = Math.round(cv.clientWidth * dpr), h = Math.round(cv.clientHeight * dpr);
    if (force || cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }
    return dpr;
  };

  Dashboard.prototype._drawWave = function () {
    var dpr = this._fitCanvas(false), ctx = this.ctx, W = this.cv.width, H = this.cv.height;
    if (!W || !H) return;
    ctx.clearRect(0, 0, W, H);
    var padL = 12 * dpr, padR = 70 * dpr, padT = 6 * dpr, padB = 18 * dpr;
    var laneH = (H - padT - padB) / this.lanes.length;
    var plotW = W - padL - padR, step = plotW / (BUF - 1);

    ctx.font = (11 * dpr) + 'px "IBM Plex Sans", system-ui, sans-serif';
    ctx.textBaseline = 'top';
    for (var li = 0; li < this.lanes.length; li++) {
      var lane = this.lanes[li], arr = this[lane.key], top = padT + li * laneH, n = arr.length;
      // frame + grid
      ctx.strokeStyle = '#e3e9f0'; ctx.lineWidth = 1 * dpr;
      ctx.strokeRect(padL, top + 2 * dpr, plotW, laneH - 4 * dpr);
      ctx.beginPath();
      for (var g = 1; g < 4; g++) { var gx = padL + plotW * g / 4; ctx.moveTo(gx, top + 2 * dpr); ctx.lineTo(gx, top + laneH - 2 * dpr); }
      ctx.moveTo(padL, top + laneH / 2); ctx.lineTo(padL + plotW, top + laneH / 2);
      ctx.strokeStyle = '#eef2f6'; ctx.stroke();

      // scale from the most recent 2.5 s (older data is clipped)
      var from = Math.max(0, n - 125), lo = Infinity, hi = -Infinity, i;
      for (i = from; i < n; i++) { if (arr[i] < lo) lo = arr[i]; if (arr[i] > hi) hi = arr[i]; }
      if (n === 0) { lo = 0; hi = 1; }
      if (lane.key === 'f') { var a = Math.max(Math.abs(lo), Math.abs(hi), 0.003); lo = -a * 1.25; hi = a * 1.25; }
      else { var span = Math.max(hi - lo, 300), mid = (hi + lo) / 2; lo = mid - span * 0.62; hi = mid + span * 0.62; }
      lane.lo = lane.lo === null ? lo : lane.lo + (lo - lane.lo) * 0.12;
      lane.hi = lane.hi === null ? hi : lane.hi + (hi - lane.hi) * 0.12;

      // trace
      if (n > 1) {
        ctx.save();
        ctx.beginPath(); ctx.rect(padL, top + 3 * dpr, plotW, laneH - 6 * dpr); ctx.clip();
        ctx.beginPath();
        var x0 = padL + (BUF - n) * step, rng = lane.hi - lane.lo || 1;
        for (i = 0; i < n; i++) {
          var x = x0 + i * step, y = top + laneH - 4 * dpr - (arr[i] - lane.lo) / rng * (laneH - 8 * dpr);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = lane.color; ctx.lineWidth = 1.7 * dpr; ctx.lineJoin = 'round'; ctx.stroke();
        ctx.restore();
      }
      // label + latest value
      ctx.fillStyle = '#5b6b7c'; ctx.textAlign = 'left';
      ctx.fillText(lane.label, padL + 8 * dpr, top + 7 * dpr);
      ctx.fillStyle = lane.color; ctx.textAlign = 'left';
      var val = n ? (lane.key === 'f' ? (arr[n - 1] * 100).toFixed(2) + ' %' : String(arr[n - 1])) : '--';
      ctx.fillText(val, padL + plotW + 8 * dpr, top + laneH / 2 - 6 * dpr);
    }
    ctx.fillStyle = '#8795a5'; ctx.textAlign = 'left'; ctx.fillText('-6 s', padL, H - padB + 4 * dpr);
    ctx.textAlign = 'right'; ctx.fillText('now', padL + plotW, H - padB + 4 * dpr);
  };

  ns.Dashboard = Dashboard;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * main.js  -  Wiring and main loop
 *
 * TO USE REAL HARDWARE LATER: replace the sensor below with
 *     new HbSim.sensors.WebSerialSensor()      (see sensor.js)
 * Everything downstream (signal processing, Hb estimation, display, BLE,
 * dashboard) consumes the same {t, red, ir} samples and is unchanged.
 * ========================================================================== */
(function (ns) {
  'use strict';

  function start() {
    var sensor = new ns.sensors.SimulatedMAX30102();      // <- swap point
    var ble = new ns.BleLink(ns.Config.device.bleName);
    var led = new ns.RgbLed();
    var buzzer = new ns.Buzzer();
    var battery = new ns.Battery();
    var store = new ns.NvStore('hbsim.');
    var serial = new ns.SerialPort();

    var fw = new ns.Firmware({ sensor: sensor, ble: ble, led: led, buzzer: buzzer, battery: battery, store: store, serial: serial });
    var user = new ns.VirtualUser(sensor);
    var deps = { fw: fw, sensor: sensor, user: user, battery: battery, led: led, buzzer: buzzer, ble: ble, store: store, serial: serial };

    // circuit first: it creates the <canvas id="oled"> that the display driver draws into
    var circuit = new ns.CircuitView(deps);
    var oled = new ns.SSD1306(document.getElementById('oled'));
    var display = new ns.DisplayController(oled);

    var toolbar = new ns.Toolbar(deps);
    new ns.Tabs();
    var monitor = new ns.SerialMonitor(deps);
    var inspector = new ns.Inspector(deps, circuit);
    var dashboard = new ns.Dashboard(deps);

    // Browsers only allow audio after a user gesture.
    var unlock = function () {
      buzzer.unlock();
      document.removeEventListener('pointerdown', unlock, true);
      document.removeEventListener('keydown', unlock, true);
    };
    document.addEventListener('pointerdown', unlock, true);
    document.addEventListener('keydown', unlock, true);

    fw.powerOn(0);

    var last = performance.now(), lastOled = 0;
    function frame(ts) {
      var dt = Math.min(ts - last, 100);              // pause gracefully when the tab was hidden
      last = ts;
      ns.clock.now += dt * ns.clock.scale;

      fw.update(ns.clock.now);
      var snap = fw.snapshot();
      user.update(snap);

      if (ts - lastOled > 50) { display.render(snap); lastOled = ts; }   // ~20 fps OLED refresh
      circuit.update(snap);
      inspector.update(snap);
      toolbar.update(snap);
      monitor.flush();
      dashboard.render();
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    // Handy for experiments in the browser console.
    ns.debug = { fw: fw, sensor: sensor, ble: ble, battery: battery, user: user };
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})(window.HbSim);

</script>
