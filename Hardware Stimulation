  function py(i) { return 225 + i * 21; }

  /* ---- small drawing helpers (return SVG strings) ----------------------- */
  function gnd(x, y, dir) {                         // ground flag: stub + 3 bars. dir: 'l' stub points left
    var s = dir === 'l' ? -1 : 1;
