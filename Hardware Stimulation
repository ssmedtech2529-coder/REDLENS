  /* ---- sample pump ------------------------------------------------------ */
  /* Pull raw samples, run contact detection, optionally the DSP chain.
   * Returns decimated (50 Hz) frames for the BLE telemetry stream. */
  Firmware.prototype._ingest = function (now, dsp) {
    var raw = this.sensor.pull(now), out = [];
    for (var i = 0; i < raw.length; i++) {
      var s = raw[i], f = 0;
      this.lastContact = this.contact.update(s.ir);
      if (dsp) {
        var r = this.processor.process(s.t, s.red, s.ir);
        f = r.f;
        if (r.beat) this.led.flash(now, 80, 'white');
      }
      this.sampleCount++;
      if (this.sampleCount % 2 === 0) out.push({ red: s.red, ir: s.ir, f: f });
      if (this.sampleCount % 4 === 0) { this.recent.push(f); if (this.recent.length > 200) this.recent.shift(); }
