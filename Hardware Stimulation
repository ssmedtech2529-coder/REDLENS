  };

  /* Scanning screen: same rows as the spec example; mini waveform on the right. */
  DisplayController.prototype._scanning = function (d, s) {
    var L = s.live;
    d.text(0, 0, s.name, 1);
    batteryLine(d, s, 8);
    d.text(0, 16, 'Scanning' + dots(s.stateTime), 1);
    d.text(0, 24, 'Hb: --.- g/dL', 1);
    d.text(0, 32, 'HR: ' + (L.hr ? Math.round(L.hr) : '--') + ' BPM', 1);
    d.text(0, 40, 'SpO2: ' + (L.spo2 ? Math.round(L.spo2) : '--') + '%', 1);
    d.text(0, 48, 'Signal: ' + (L.quality || 'Searching'), 1);
    d.progress(0, 56, 128, 8, s.progress);
