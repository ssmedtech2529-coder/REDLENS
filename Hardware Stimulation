<script>
/* ==========================================================================
 * hb.js  -  Hemoglobin estimation (SIMULATED calibration model)
 *
 * The model is a linear map from the optical feature x = ln(DC_ir / DC_red)
 * to Hb in g/dL. Its coefficients are derived analytically from the toy
 * optical model in sensor.js - they are NOT fitted to clinical data and
 * carry no clinical meaning.
 *
 * A real research prototype would replace COEFFICIENTS with a regression
 * fitted against paired lab hemoglobin measurements (multiple features:
 * both DC ratios, AC/DC ratios, perfusion index, skin-tone proxy, finger
 * temperature, ...), validated on a held-out cohort.
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util;

  var COEFFICIENTS = {
    id: 'SIM-CAL-0.3 (synthetic)',
    intercept: -1.4286,       // g/dL
    slope: 28.571,            // g/dL per unit of ln(DC_ir / DC_red)
    userOffset: 0,            // per-device calibration offset (g/dL)
    sigmaModel: 0.55,         // model uncertainty from finger path-length variation (g/dL, 1 sigma)
  };

  function HbEstimator() { this.model = COEFFICIENTS; }

  /* Hb from a single feature value (unclamped). */
  HbEstimator.prototype.fromFeature = function (x) {
    return this.model.intercept + this.model.slope * x + this.model.userOffset;
  };

  /* Combine per-second windows [{ x, q }] into one estimate.
   * Windows are quality weighted; outliers vs. the median are dropped. */
  HbEstimator.prototype.estimate = function (windows) {
