  };

  DisplayController.prototype._wave = function (d, wave, x, y, w, h) {
    if (!wave || wave.length < 4) return;
    var n = Math.min(wave.length, 90), seg = wave.slice(-n), min = Infinity, max = -Infinity, i;
    for (i = 0; i < n; i++) { if (seg[i] < min) min = seg[i]; if (seg[i] > max) max = seg[i]; }
    var span = Math.max(max - min, 1e-6), px = null, py = null;
    for (i = 0; i < n; i++) {
