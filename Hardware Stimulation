    var min = Infinity, max = -Infinity, i, v;
    for (i = 0; i < LUT_N; i++) {
      var p = i / LUT_N;
      v = gauss(p, 0.20, 0.085) + 0.38 * gauss(p, 0.56, 0.11);   // systolic peak + dicrotic wave
      LUT[i] = v; if (v < min) min = v; if (v > max) max = v;
    }
    var sum = 0;
    for (i = 0; i < LUT_N; i++) { LUT[i] = (LUT[i] - min) / (max - min); sum += LUT[i]; }
    LUT_MEAN = sum / LUT_N;                                       // peak-to-peak = 1
  })();
  function shapeAt(p) {
    var x = p * LUT_N, i = Math.floor(x) % LUT_N, f = x - Math.floor(x);
    return LUT[i] * (1 - f) + LUT[(i + 1) % LUT_N] * f;
  }

  /* ---- Optical model constants (tissue + hemoglobin absorption) --------
   * DC_ch = K_ch * exp(-(A_ch + E_ch * Hb * L))
   * Hb is in g/dL, L is a per-finger path-length factor (~1.0 +/- 4 %).
   * Red (660 nm) is absorbed more strongly by Hb than IR (880 nm) in this
   * toy model, so ln(DC_ir / DC_red) rises linearly with Hb.            */
  var OPTICS = { Ki: 212200, Kr: 201850, Ai: 0.30, Ar: 0.30, Ei: 0.020, Er: 0.055 };

  /* ---- Finger contact quality presets ---------------------------------- */
  var CONTACT = {
    excellent: { noise: 0.00012, piScale: 1.00, burstRate: 0.00, burstAmp: 0.0, leak: 0 },
    good:      { noise: 0.00030, piScale: 0.90, burstRate: 0.01, burstAmp: 0.8, leak: 300 },
    fair:      { noise: 0.00085, piScale: 0.60, burstRate: 0.05, burstAmp: 1.4, leak: 1500 },
    poor:      { noise: 0.00220, piScale: 0.35, burstRate: 0.25, burstAmp: 3.0, leak: 5000 },
  };
  var FRONT_ENDS = {
    max30102: { label: 'MAX30102 (integrated)', noiseScale: 1.0, leakScale: 1.0 },
    afe4404:  { label: 'BPW34 + AFE4404 (external)', noiseScale: 0.55, leakScale: 0.6 },
  };

  function pickAutoContact() {
    var r = Math.random();
    if (r < 0.50) return 'excellent';
    if (r < 0.85) return 'good';
    if (r < 0.97) return 'fair';
    return 'poor';
  }

  function newSubject(preset) {
    var hb;
    if (preset === 'low') hb = U.rand(9.0, 10.8);
    else if (preset === 'typical') hb = U.rand(12.4, 14.6);
    else if (preset === 'high') hb = U.rand(15.6, 17.4);
    else hb = U.clamp(13.4 + 2.0 * U.randn(), 9.0, 17.5);
    return {
      hb: hb,
      hr: U.clamp(72 + 9 * U.randn(), 61, 98),
      spo2: U.clamp(97.6 + 1.0 * U.randn(), 95.5, 99.3),
      pi: U.clamp(0.016 * Math.exp(0.35 * U.randn()), 0.007, 0.032),  // AC/DC at IR
      L: U.clamp(1 + 0.04 * U.randn(), 0.9, 1.1),
      respHz: U.rand(0.2, 0.3),
