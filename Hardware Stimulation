<script>
/* ==========================================================================
 * user.js  -  Virtual user (the human in the loop)
 *
 * In 'auto' mode the virtual user follows the on-device instructions:
 * places a finger when asked and lifts it after the scan. In 'manual' mode
 * the person using the demo does it with the "Place finger" button.
 * Not used with real hardware (a real finger does this).
 * ========================================================================== */
(function (ns) {
  'use strict';

  function VirtualUser(sensor) {
    this.sensor = sensor;
    this.mode = 'auto';            // 'auto' | 'manual'
    this.stateSince = 0;
    this.lastState = '';
  }

  VirtualUser.prototype.placeFinger = function () { this.sensor.setFingerPresent(true); };
  VirtualUser.prototype.liftFinger = function () { this.sensor.setFingerPresent(false); };
  VirtualUser.prototype.toggleFinger = function () { this.sensor.setFingerPresent(!this.sensor.isFingerPresent()); };
  VirtualUser.prototype.shake = function () { this.sensor.injectMotion(1500, 3.0); };

  /* Call every frame with the firmware snapshot. */
  VirtualUser.prototype.update = function (snap) {
    if (snap.state !== this.lastState) { this.lastState = snap.state; this.stateSince = snap.now; }
    if (this.mode !== 'auto') return;
    var t = snap.now - this.stateSince, on = this.sensor.isFingerPresent();
    if (snap.state === 'PLACE_FINGER' && !on && t > 1500) this.placeFinger();
    var idle = snap.state === 'COMPLETE' || snap.state === 'ERROR' || snap.state === 'READY' || snap.state === 'BOOT' || snap.state === 'OFF';
    if (idle && on && t > 2500) this.liftFinger();
  };

  ns.VirtualUser = VirtualUser;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * firmware.js  -  Device firmware (state machine) - the "main loop"
 *
 *   BOOT -> READY -> PLACE_FINGER -> SETTLING -> ACQUIRING -> PROCESSING
 *        -> COMPLETE   (or ERROR at any point)
 *
 * This is the part you would port to Arduino/ESP-IDF as loop(). It only
 * talks to hardware through the injected objects (sensor, ble, led, buzzer,
 * battery, store), so swapping in real drivers does not change this file.
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util, C = ns.Config;

  var S = {
    OFF: 'OFF', BOOT: 'BOOT', READY: 'READY', PLACE: 'PLACE_FINGER', SETTLE: 'SETTLING',
    ACQUIRE: 'ACQUIRING', PROCESS: 'PROCESSING', COMPLETE: 'COMPLETE', ERROR: 'ERROR',
  };
  var ACTIVE = [S.PLACE, S.SETTLE, S.ACQUIRE, S.PROCESS];

  /* Minimal UART emulation: the firmware println()s, the UI shows a serial monitor. */
  function SerialPort() { this.handlers = []; }
  SerialPort.prototype.on = function (fn) { this.handlers.push(fn); };
  SerialPort.prototype.println = function (text, kind) {
    for (var i = 0; i < this.handlers.length; i++) this.handlers[i]({ t: ns.clock.now, text: text, kind: kind || 'out' });
  };
  ns.SerialPort = SerialPort;

  function Firmware(deps) {
    this.sensor = deps.sensor; this.ble = deps.ble; this.led = deps.led;
    this.buzzer = deps.buzzer; this.battery = deps.battery; this.store = deps.store;
    this.serial = deps.serial || { println: function () {} };
    this.processor = new ns.SignalProcessor(this.sensor.fs);
    this.contact = new ns.ContactDetector();
    this.estimator = new ns.HbEstimator();
    this.history = this.store.get('history', []);
    this.nextId = this.store.get('nextId', 1);
    this.state = S.OFF; this.now = 0; this.stateStart = 0;
    this.lastBtn = -1e9;
    this.bootLog = []; this.bootSteps = []; this.bleStarted = false;
    this.message = ''; this.errorLines = [];
    this.metrics = this.processor.getMetrics(0);
    this.lastMetricsAt = 0; this.lastContact = 'none';
    this.recent = []; this.sampleCount = 0;
    this.winLog = []; this.windowCount = 0; this.lastSec = 0; this.provisional = null;
    this.lossCount = 0; this.lastRecord = null;
    var self = this;
    this.ble.on('connected', function () { self._syncHistory(); });
  }
  Firmware.States = S;

  Firmware.prototype._p = function (text, kind) { this.serial.println(text, kind); };

  /* ---- power / boot ----------------------------------------------------- */
  Firmware.prototype.powerOn = function (now) {
    this.now = now; this.sensor.end(); this.ble.stop();
    this._p('rst:0x1 (POWERON_RESET),boot:0x13 (SPI_FAST_FLASH_BOOT)');
    this._p('[BOOT] ' + C.device.name + ' ' + C.device.firmware + ' (simulation)');
    this.bleStarted = false; this.bootLog = [];
    var fe = this.sensor.frontEndLabel ? this.sensor.frontEndLabel() : 'MAX30102';
    this.bootSteps = [
      [150, 'ESP32 CPU0/1 ok'],
      [600, 'I2C: 0x3C 0x57'],
      [1000, 'SSD1306 init ok'],
      [1450, fe.indexOf('AFE') >= 0 ? 'BPW34/AFE4404 ok' : 'MAX30102 id 0x15'],
      [1900, 'BLE adv ' + C.device.bleName],
      [2300, 'Battery ' + Math.floor(this.battery.pct) + '% ' + this.battery.voltage().toFixed(2) + 'V'],
