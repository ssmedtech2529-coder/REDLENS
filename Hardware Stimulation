<script>
/* ==========================================================================
 * signal.js  -  Optical signal processing (runs identically on real data)
 *
 *   ContactDetector   decides when a finger is on the sensor and stable
 *   SignalProcessor   DC removal, 0.5-5 Hz band-pass, beat detection,
 *                     heart rate, SpO2 (ratio-of-ratios), signal quality
 *
 * Port notes: everything is streaming, O(1) per sample and uses only basic
 * arithmetic, so it translates directly to C++ on the ESP32.
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util;

  ns.QUALITY_LEVELS = ['Poor', 'Fair', 'Good', 'Excellent'];
  ns.qualityLabel = function (score) {
    if (score >= 78) return 'Excellent';
    if (score >= 58) return 'Good';
    if (score >= 45) return 'Fair';
    return 'Poor';
  };

  /* ---- 2nd-order Butterworth-style biquads (RBJ cookbook) -------------- */
  function biquadCoef(type, fc, fs) {
    var Q = Math.SQRT1_2, w0 = 2 * Math.PI * fc / fs;
    var cs = Math.cos(w0), alpha = Math.sin(w0) / (2 * Q), b0, b1, b2;
    if (type === 'lp') { b0 = (1 - cs) / 2; b1 = 1 - cs; b2 = (1 - cs) / 2; }
    else { b0 = (1 + cs) / 2; b1 = -(1 + cs); b2 = (1 + cs) / 2; }
    var a0 = 1 + alpha;
    return { b0: b0 / a0, b1: b1 / a0, b2: b2 / a0, a1: -2 * cs / a0, a2: (1 - alpha) / a0 };
  }
  function Biquad(c) { this.c = c; this.z1 = 0; this.z2 = 0; }
  Biquad.prototype.process = function (x) {       // transposed direct form II
    var c = this.c, y = c.b0 * x + this.z1;
    this.z1 = c.b1 * x - c.a1 * y + this.z2;
    this.z2 = c.b2 * x - c.a2 * y;
    return y;
  };

  /* ======================================================================
   * ContactDetector - states: none -> settling -> stable -> lost
   * ==================================================================== */
  function ContactDetector() {
    this.onThreshold = 30000;    // raw IR counts
    this.offThreshold = 20000;
    this.reset();
  }
  ContactDetector.prototype.reset = function () {
    this.state = 'none'; this.ema = null; this.ring = []; this.stableRun = 0; this.lowRun = 0;
  };
  ContactDetector.prototype.update = function (ir) {
    if (this.ema === null) this.ema = ir;
    this.ema += 0.2 * (ir - this.ema);
    this.ring.push(this.ema);
    if (this.ring.length > 31) this.ring.shift();

    if (this.state === 'none') {
      if (this.ema > this.onThreshold) { this.state = 'settling'; this.stableRun = 0; }
    } else if (this.state === 'settling') {
      if (this.ema < this.offThreshold) { this.state = 'none'; }
      else if (this.ring.length > 30) {
        var change = Math.abs(this.ema - this.ring[0]) / this.ema;     // change over 300 ms
        this.stableRun = change < 0.01 ? this.stableRun + 1 : 0;
        if (this.stableRun > 30) this.state = 'stable';
      }
    } else if (this.state === 'stable') {
      this.lowRun = this.ema < this.offThreshold ? this.lowRun + 1 : 0;
      if (this.lowRun > 40) this.state = 'lost';
    }
    return this.state;
  };

  /* ======================================================================
   * SignalProcessor
   * ==================================================================== */
  function SignalProcessor(fs) {
    this.fs = fs || 100;
    this.hpCoef = biquadCoef('hp', 0.5, this.fs);
    this.lpCoef = biquadCoef('lp', 5.0, this.fs);
    this.reset();
  }

  SignalProcessor.prototype.reset = function () {
    this.n = 0; this.dcR = 0; this.dcI = 0;
    this.hpR = new Biquad(this.hpCoef); this.lpR = new Biquad(this.lpCoef);
    this.hpI = new Biquad(this.hpCoef); this.lpI = new Biquad(this.lpCoef);
    this.rmsR2 = 0; this.rmsI2 = 0; this.noise2 = 0;
    this.pn1 = 0; this.pn2 = 0;                 // previous normalised IR samples
    this.f1 = 0; this.f2 = 0;                   // previous filtered IR samples
    this.lastT = 0; this.lastPeakT = null;
    this.ibis = []; this.amps = []; this.ampEst = 0; this.beatCount = 0;
    this.hr = null; this.spo2 = null; this.motionUntil = 0;
    this.filtRed = 0; this.filtIr = 0;
  };

  /* Feed one raw sample. Returns { f, fr, beat } where f is the filtered IR
   * pulse (fraction of DC, positive on systole). */
  SignalProcessor.prototype.process = function (t, red, ir) {
    this.n++;
    var a = this.n < 200 ? 1 / this.n : 0.004;           // running mean first, then ~2.5 s EMA
    this.dcR += a * (red - this.dcR);
    this.dcI += a * (ir - this.dcI);

    // DC-normalised, inverted (more blood -> less light -> positive pulse)
    var pr = -(red - this.dcR) / this.dcR;
    var pi = -(ir - this.dcI) / this.dcI;
    var fr = this.lpR.process(this.hpR.process(pr));
    var fi = this.lpI.process(this.hpI.process(pi));
    this.filtRed = fr; this.filtIr = fi;

    // running RMS (AC amplitude) and high-frequency noise estimate
    var b = this.n < 250 ? 1 / this.n : 0.004;
    this.rmsR2 += b * (fr * fr - this.rmsR2);
    this.rmsI2 += b * (fi * fi - this.rmsI2);
    var d2 = pi - 2 * this.pn1 + this.pn2;               // 2nd difference ~ sqrt(6) * sigma
    this.noise2 += b * (d2 * d2 - this.noise2);
    this.pn2 = this.pn1; this.pn1 = pi;

    // beat detection on the previous sample (local maximum above threshold)
    var beat = false, rmsI = Math.sqrt(this.rmsI2);
    if (this.n > 5) {
      var thr = this.beatCount < 4 ? 0.8 * rmsI : Math.max(0.5 * this.ampEst, 0.5 * rmsI);
      if (this.f1 > this.f2 && this.f1 >= fi && this.f1 > thr && this.n > this.fs) {
        beat = this._onPeak(this.lastT, this.f1);
      }
      // motion detector: huge excursions relative to the learned amplitude
      var ref = Math.max(this.ampEst, 1.5 * rmsI);
      if (this.beatCount >= 4 && Math.abs(fi) > 3.5 * ref) this.motionUntil = t + 1500;
    }
    this.f2 = this.f1; this.f1 = fi; this.lastT = t;

    // smoothed SpO2 (every 5th sample)
    if (this.n % 5 === 0 && this.n > this.fs * 1.5 && this.rmsI2 > 0) {
      // subtract the in-band noise power from both channels before taking the ratio
      var nv = this.noise2 / 6 * 0.09;
      var R = Math.sqrt(Math.max(this.rmsR2 - nv, 1e-12) / Math.max(this.rmsI2 - nv, 1e-12));
      var raw = U.clamp(110 - 25 * R, 70, 100);
      this.spo2 = this.spo2 === null ? raw : this.spo2 + 0.03 * (raw - this.spo2);
    }
    return { f: fi, fr: fr, beat: beat };
  };

  SignalProcessor.prototype._onPeak = function (tp, amp) {
    var refractory = 380;                                  // ms (<= ~155 BPM)
    if (this.lastPeakT !== null) {
      var ibi = tp - this.lastPeakT;
      if (ibi < refractory) return false;
      if (ibi > 2200) {                                    // missed beat(s): restart chain
        this.lastPeakT = tp; this.ampEst = amp; return false;
      }
      this.ibis.push(ibi); if (this.ibis.length > 8) this.ibis.shift();
    }
    this.lastPeakT = tp;
    this.beatCount++;
    this.amps.push(amp); if (this.amps.length > 8) this.amps.shift();
    this.ampEst = this.beatCount <= 1 ? amp : 0.75 * this.ampEst + 0.25 * amp;
    if (this.ibis.length >= 3) {
      var inst = 60000 / U.median(this.ibis.slice(-6));
      this.hr = this.hr === null ? inst : this.hr + 0.4 * (inst - this.hr);
    }
    return true;
  };

  function cv(a) {
    if (a.length < 3) return 1;
    var m = U.mean(a);
    return m > 0 ? U.std(a) / m : 1;
  }

  /* Snapshot of the current vitals and quality metrics. */
  SignalProcessor.prototype.getMetrics = function (nowMs) {
    var rmsI = Math.sqrt(this.rmsI2), rmsR = Math.sqrt(this.rmsR2);
    var R = rmsI > 0 ? rmsR / rmsI : null;
    var piPct = 100 * 3.3 * rmsI;                           // peak-to-peak / DC, in %
    var sigma = Math.sqrt(this.noise2 / 6) * 0.3;           // in-band noise (0.5-5 Hz of 50 Hz)
    var snrDb = rmsI > 0 ? 20 * Math.log(rmsI / (sigma + 1e-9)) / Math.LN10 : 0;
    var ibiCv = cv(this.ibis.slice(-6)), ampCv = cv(this.amps.slice(-6));
    var motion = nowMs < this.motionUntil;

    var snrS = U.clamp((snrDb - 10) / 22, 0, 1);
    var piS = U.clamp((piPct - 0.3) / 0.9, 0, 1);
    var regS = 1 - U.clamp(ibiCv / 0.15, 0, 1);
    var ampS = 1 - U.clamp(ampCv / 0.35, 0, 1);
    var pen = motion ? 0.6 : 1;
    var score = 100 * (0.35 * snrS + 0.2 * piS + 0.25 * regS + 0.2 * ampS) * pen;
    var stability = 100 * (0.5 * regS + 0.5 * ampS) * pen;
    var searching = this.beatCount < 4;

    return {
      hr: this.hr, spo2: this.spo2, R: R, piPct: piPct, snrDb: snrDb,
      ibiCv: ibiCv, ampCv: ampCv, motion: motion, beats: this.beatCount,
      qualityScore: searching ? 0 : score,
      quality: searching ? null : ns.qualityLabel(score),
      stability: searching ? 0 : stability,
    };
  };

  /* Features used by the Hb estimator. ln(DC_ir/DC_red) is the optical
   * feature that carries (most of) the hemoglobin information. */
  SignalProcessor.prototype.getFeatures = function () {
    return {
      x: this.dcR > 0 && this.dcI > 0 ? Math.log(this.dcI / this.dcR) : 0,
      dcRed: this.dcR, dcIr: this.dcI,
    };
  };

  ns.ContactDetector = ContactDetector;
  ns.SignalProcessor = SignalProcessor;
})(window.HbSim);

