      case S.COMPLETE: led.set('green', 'solid', 1000); bz.melody([[1500, 90], [2200, 150]]); break;
      case S.ERROR: this.sensor.end(); led.set('red', 'blink', 600); bz.melody([[420, 220], [420, 220]]); break;
