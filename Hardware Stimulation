  };

  DisplayController.prototype._error = function (d, s) {
    d.fillRect(0, 0, 128, 10, 1);
    d.textCenter(1, 'SCAN STOPPED', 1, 0);
    var lines = s.errorLines || ['Unknown error'];
    for (var i = 0; i < lines.length && i < 4; i++) d.textCenter(18 + i * 9, lines[i], 1);
    if (Math.floor(s.stateTime / 600) % 2 === 0) d.textCenter(56, 'Press START to retry', 1);
  };

  ns.SSD1306 = SSD1306;
  ns.DisplayController = DisplayController;
})(window.HbSim);

