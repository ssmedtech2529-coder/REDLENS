      h += '<circle class="pin" cx="554" cy="' + py(i) + '" r="4.2"/><text class="pin-t" x="540" y="' + (py(i) + 3.2) + '" text-anchor="end">' + RIGHT[i] + '</text>';
    }
    // BLE radio waves (upper right of the antenna)
