    h += '<rect class="batt" x="40" y="225" width="140" height="90" rx="8"/><rect class="batt-nub" x="176" y="250" width="6" height="26" rx="2"/>';
    h += '<text class="batt-t" x="110" y="248" text-anchor="middle">LiPo 3.7 V</text>';
    for (i = 0; i < 5; i++) h += '<rect class="seg" id="bseg' + i + '" x="' + (54 + i * 24) + '" y="262" width="20" height="18" rx="2"/>';
    h += '<text id="batt-pct" class="batt-t big" x="110" y="305" text-anchor="middle">--%</text>';
    h += '<path id="batt-bolt" class="bolt" d="M160 232 l-8 14 h6 l-4 12 l10 -16 h-6 z"/>';
    h += '<text class="chip-t" x="188" y="259" text-anchor="end" style="fill:#fff">+</text>';
    h += '<text class="label" x="110" y="206" text-anchor="middle">Battery + charger</text>';
    h += '</g>';
    h += gnd(180, 290, 'r').replace('class="flag"', 'class="flag"');

    /* ---------------- RGB LED ---------------- */
    h += '<g class="part" data-part="led">';
    h += '<rect class="outline" x="198" y="340" width="146" height="96" rx="9"/>';
