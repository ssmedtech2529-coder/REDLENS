  }

  /* ======================================================================
   * SimulatedMAX30102
   * ==================================================================== */
  function SimulatedMAX30102() {
    this.fs = ns.Config.sensor.fs;
    this.name = 'MAX30102';
    this.options = { subject: 'random', contact: 'auto', frontEnd: 'max30102' };
    this.active = false;
    this.fingerTarget = false;
    this.coupling = 0;           // 0 = no finger, 1 = fully covered
    this.nextT = null;
    this._resetState();
    this.subject = newSubject('random');
    this.contactMode = 'excellent';
    this.cm = CONTACT.excellent;
    this.fe = FRONT_ENDS.max30102;
  }

  SimulatedMAX30102.prototype._resetState = function () {
    this.t = 0;                         // sensor seconds since begin()
    this.phase = Math.random();
    this.hrWander = 0;
    this.contactT = 0;
    this.motion = null;
    this.ph1 = Math.random() * 6.28; this.ph2 = Math.random() * 6.28;
  };

  SimulatedMAX30102.prototype.setOptions = function (o) {
    for (var k in o) if (Object.prototype.hasOwnProperty.call(o, k)) this.options[k] = o[k];
  };

  SimulatedMAX30102.prototype.frontEndLabel = function () { return this.fe.label; };

  /* Power up the AFE and pick a new virtual subject for this scan. */
  SimulatedMAX30102.prototype.begin = function () {
    this.subject = newSubject(this.options.subject);
    this.contactMode = this.options.contact === 'auto' ? pickAutoContact() : this.options.contact;
    this.cm = CONTACT[this.contactMode];
    this.fe = FRONT_ENDS[this.options.frontEnd] || FRONT_ENDS.max30102;
    this._resetState();
    this.coupling = this.fingerTarget ? 1 : 0;
    this.nextT = null;
    this.active = true;
  };

  SimulatedMAX30102.prototype.end = function () { this.active = false; this.nextT = null; };

  SimulatedMAX30102.prototype.setFingerPresent = function (on) { this.fingerTarget = !!on; };
  SimulatedMAX30102.prototype.isFingerPresent = function () { return this.fingerTarget; };
  SimulatedMAX30102.prototype.getCoupling = function () { return this.coupling; };

  /* Trigger a motion artifact (user shakes / presses the finger). */
  SimulatedMAX30102.prototype.injectMotion = function (ms, amp) {
    this.motion = { start: this.t, dur: (ms || 1500) / 1000, amp: amp || 3.0, f: U.rand(2.0, 3.5) };
  };

  /* Hidden "truth" of the virtual subject - only used to show how far the
   * estimate is from the simulated reference (educational). */
  SimulatedMAX30102.prototype.getGroundTruth = function () {
    return { hb: this.subject.hb, hr: this.subject.hr, spo2: this.subject.spo2, contact: this.contactMode };
  };

  SimulatedMAX30102.prototype.pull = function (now) {
    if (!this.active) { this.nextT = null; return []; }
    if (this.nextT === null) this.nextT = now;
    var out = [], guard = 0, step = 1000 / this.fs;
    while (this.nextT <= now && guard++ < 400) {
      out.push(this._sample(this.nextT));
      this.nextT += step;
    }
    if (guard >= 400) this.nextT = now + step;
    return out;
  };

  SimulatedMAX30102.prototype._sample = function (tMs) {
    var dt = 1 / this.fs, s = this.subject, cm = this.cm, fe = this.fe;
    this.t += dt;
    var tt = this.t;

    // finger coupling (first-order lag toward target)
    var tau = this.fingerTarget ? 0.18 : 0.12;
    this.coupling += (((this.fingerTarget ? 1 : 0) - this.coupling) * (1 - Math.exp(-dt / tau)));
    this.contactT = this.coupling > 0.5 ? this.contactT + dt : 0;

    // heart rate with respiratory sinus arrhythmia + slow wander (OU process)
    this.hrWander += (-this.hrWander * 0.1 * dt) + 0.35 * Math.sqrt(dt) * U.randn();
    var hr = s.hr + 2.5 * Math.sin(2 * Math.PI * 0.25 * tt) + this.hrWander;
    this.phase = (this.phase + hr * dt / 60) % 1;
    var shape = shapeAt(this.phase) - LUT_MEAN;
    var shapeR = shapeAt((this.phase + 0.995) % 1) - LUT_MEAN;   // tiny channel skew

    // optical DC levels from the Hb model
    var dcIr = OPTICS.Ki * Math.exp(-(OPTICS.Ai + OPTICS.Ei * s.hb * s.L));
    var dcRed = OPTICS.Kr * Math.exp(-(OPTICS.Ar + OPTICS.Er * s.hb * s.L));

    // SpO2 -> R ratio (empirical SpO2 = 110 - 25 R)
    var spo2 = s.spo2 + 0.3 * Math.sin(2 * Math.PI * 0.03 * tt);
    var R = (110 - spo2) / 25;
    var piIr = s.pi * cm.piScale, piRed = piIr * R;

    // slow physiological / mechanical modulation (common to both channels)
    var settle = 0.04 * Math.exp(-this.contactT / 1.2);          // pressure settling
    var common = 1 + 0.004 * Math.sin(2 * Math.PI * s.respHz * tt + this.ph1) +
                 0.003 * Math.sin(2 * Math.PI * 0.05 * tt + this.ph2) + settle;

    // motion artifacts (random bursts + user-injected)
    var mot = 0, noiseK = 1;
    if (!this.motion && cm.burstRate > 0 && this.coupling > 0.9 && Math.random() < cm.burstRate * dt) {
      this.motion = { start: tt, dur: U.rand(0.5, 1.4), amp: cm.burstAmp, f: U.rand(2.0, 3.5) };
    }
    if (this.motion) {
      var tb = tt - this.motion.start;
      if (tb >= this.motion.dur) this.motion = null;
      else {
        mot = this.motion.amp * s.pi * Math.sin(Math.PI * tb / this.motion.dur) *
              Math.sin(2 * Math.PI * this.motion.f * tb);
        noiseK = 4;
      }
    }

    var nz = cm.noise * fe.noiseScale * noiseK;
    var leak = cm.leak * fe.leakScale;
    var irFinger = dcIr * common * (1 - piIr * shape + mot) + leak + nz * dcIr * U.randn();
    var redFinger = dcRed * common * (1 - piRed * shapeR + mot * 0.9) + leak * 0.8 + nz * dcRed * U.randn();

    // no-finger ambient level (a few thousand counts), blended by coupling
    var ambR = 1400 + 25 * U.randn(), ambI = 1900 + 25 * U.randn();
    var c = this.coupling;
    var red = ambR * (1 - c) + redFinger * c;
    var ir = ambI * (1 - c) + irFinger * c;
    var max = Math.pow(2, ns.Config.sensor.adcBits) - 1;
    return { t: tMs, red: U.clamp(Math.round(red), 0, max), ir: U.clamp(Math.round(ir), 0, max) };
  };

  /* ======================================================================
   * WebSerialSensor  -  skeleton for REAL hardware (Chrome / Edge)
   *
   * Flash the ESP32 with a sketch that prints one line per sample:
   *     <red>,<ir>\n          (e.g. "71203,118940")
   * at 100 sps (MAX30105 library: particleSensor.getRed() / getIR()).
   * Then in main.js replace
   *     new HbSim.sensors.SimulatedMAX30102()
   * with
   *     new HbSim.sensors.WebSerialSensor()
