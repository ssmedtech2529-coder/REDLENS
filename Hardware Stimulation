          this.bootLog.push(this.bootSteps.shift()[1]);
          this._p('[BOOT] ' + this.bootLog[this.bootLog.length - 1]);
          if (this.bootLog.length === 5 && !this.bleStarted) { this.bleStarted = true; this.ble.start(); }
        }
        if (t >= P.bootMs) this._enter(S.READY, now);
        break;

      case S.READY:
        this.led.set(this.battery.pct < 15 ? 'amber' : 'blue', this.battery.pct < 15 ? 'blink' : 'pulse', this.battery.pct < 15 ? 1800 : 2400);
        break;

      case S.PLACE:
        samples = this._ingest(now, false);
        if (this.lastContact === 'stable') { this.message = ''; this._enter(S.SETTLE, now); }
        else if (t > P.placeTimeoutMs) this._error(['No finger detected', 'Check sensor window'], now);
        break;

      case S.SETTLE:
        samples = this._ingest(now, true);
        this._refreshMetrics(now);
        if (this.lastContact === 'lost') this._fingerLost(now);
        else if (t >= P.settleMs && this.processor.beatCount >= 3) this._enter(S.ACQUIRE, now);
        else if (t >= P.settleMs + P.pulseTimeoutMs) this._error(['No pulse found', 'Press finger gently'], now);
        break;

      case S.ACQUIRE:
        samples = this._ingest(now, true);
        this._refreshMetrics(now);
        if (this.lastContact === 'lost') { this._fingerLost(now); break; }
        var sec = Math.floor(t / 1000);
        if (sec > this.lastSec) { this.lastSec = sec; this._takeWindow(now); }
        if (t >= P.acquireMs) this._enter(S.PROCESS, now);
        break;

      case S.PROCESS:
        if (t >= P.processMs) this._finish(now);
        break;

      case S.ERROR:
        if (t > 15000) this._enter(S.READY, now);
        break;
      default: break;
    }

    this.ble.sendTelemetry({ samples: samples, status: this.status() });
  };

  Firmware.prototype._refreshMetrics = function (now) {
    if (now - this.lastMetricsAt < 200) return;
    this.lastMetricsAt = now;
    this.metrics = this.processor.getMetrics(now);
  };

  /* Once per second during ACQUIRING: store one feature window. */
  Firmware.prototype._takeWindow = function (now) {
    var m = this.processor.getMetrics(now); this.metrics = m;
    this.windowCount++;
    if (m.beats < 4 || !m.hr) return;
    var f = this.processor.getFeatures();
    this.winLog.push({ x: f.x, q: m.qualityScore, hr: m.hr, spo2: m.spo2, stab: m.stability,
                       pi: m.piPct, snr: m.snrDb, R: m.R, motion: m.motion });
    this._p('[ACQ] t=' + U.pad2(this.lastSec) + 's HR=' + Math.round(m.hr) + ' SpO2=' + Math.round(m.spo2 || 0) +
            ' Q=' + m.quality + '(' + Math.round(m.qualityScore) + ') PI=' + m.piPct.toFixed(2) + '% x=' + f.x.toFixed(3) +
            ' Hb~' + this.estimator.fromFeature(f.x).toFixed(1));
    var ok = this.winLog.filter(function (w) { return w.q >= 45; });
    if (ok.length >= 5) {
