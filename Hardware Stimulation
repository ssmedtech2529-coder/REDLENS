<script>
/* ==========================================================================
 * config.js  -  Shared configuration, virtual clock and helpers
 *
 * Everything lives under one global namespace (window.HbSim) and is loaded
 * with plain <script> tags, so the project works by double-clicking
 * index.html (ES modules are blocked on file:// in most browsers).
 *
 * RESEARCH / EDUCATIONAL SIMULATION ONLY. Not a medical device.
 * ========================================================================== */
window.HbSim = window.HbSim || {};

(function (ns) {
  'use strict';

  ns.Config = {
    device: {
      name: 'Hb Research Prototype',   // 21 chars: exactly one OLED row
      bleName: 'HB-PROTO-01',
      firmware: 'v0.9.3-sim',
      hardware: 'ESP32 DevKit V1',
    },

    sensor: {
      fs: 100,          // MAX30102 sample rate (samples / second)
      redNm: 660,
      irNm: 880,
      adcBits: 18,
    },

    // All durations are in *virtual* milliseconds (see ns.clock).
    scan: {
      bootMs: 2800,
      placeTimeoutMs: 12000,   // give up if no finger is detected
      settleMs: 2500,          // let filters + pressure settle
      pulseTimeoutMs: 8000,    // give up if no pulse is found while settling
      acquireMs: 14000,        // measurement window
      processMs: 1800,         // "Estimating Hb..." stage
      minValidFraction: 0.55,  // fraction of 1 s windows that must be usable
      maxFingerLosses: 2,
      historyLimit: 30,
    },

    hbRange: { min: 9.0, max: 17.5 },   // demonstration range (g/dL)

    safety:
      'This project is a research and educational simulation. The Hb value shown ' +
      'is an estimated demonstration only and must not be used for medical ' +
      'diagnosis or treatment.',
  };

  /* Virtual clock. main.js advances `now` each animation frame by
   * (real dt * scale), so the whole device can run at 1x, 2x or 4x speed. */
  ns.clock = { now: 0, scale: 1 };

  ns.util = {
    clamp: function (v, a, b) { return Math.min(b, Math.max(a, v)); },
    lerp: function (a, b, t) { return a + (b - a) * t; },
    rand: function (a, b) {
      if (a === undefined) { a = 0; b = 1; }
      return a + Math.random() * (b - a);
    },
    /* Standard normal random number (Box-Muller). */
    randn: function () {
      var u = 0, v = 0;
      while (u === 0) u = Math.random();
      while (v === 0) v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    },
    mean: function (a) {
      if (!a.length) return 0;
      var s = 0; for (var i = 0; i < a.length; i++) s += a[i];
      return s / a.length;
    },
    std: function (a) {
      if (a.length < 2) return 0;
      var m = ns.util.mean(a), s = 0;
      for (var i = 0; i < a.length; i++) s += (a[i] - m) * (a[i] - m);
      return Math.sqrt(s / (a.length - 1));
    },
    median: function (a) {
      if (!a.length) return 0;
      var b = a.slice().sort(function (x, y) { return x - y; });
      var m = b.length >> 1;
      return b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2;
    },
    pad2: function (n) { return (n < 10 ? '0' : '') + n; },
    clockTime: function (d) {
      var p = ns.util.pad2;
      return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    },
    round: function (v, digits) {
      var k = Math.pow(10, digits || 0);
      return Math.round(v * k) / k;
    },
  };
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * storage.js  -  Non-volatile storage (emulates ESP32 NVS / Preferences)
 *
 * Uses localStorage when the page is allowed to, and silently falls back to
 * memory when it is not (sandboxed previews, private mode, etc.).
 *
 * On real hardware: replace with Preferences.h / LittleFS.
 * ========================================================================== */
(function (ns) {
  'use strict';

  function NvStore(prefix) {
    this.prefix = prefix || 'hbsim.';
    this.mem = {};
    this.persistent = false;
    try {
      var ls = window.localStorage;
      ls.setItem(this.prefix + '__probe', '1');
      ls.removeItem(this.prefix + '__probe');
      this.persistent = true;
    } catch (e) { /* memory only */ }
  }

  NvStore.prototype.get = function (key, fallback) {
    try {
      var raw = this.persistent ? window.localStorage.getItem(this.prefix + key) : this.mem[key];
      if (raw === null || raw === undefined) return fallback;
      return JSON.parse(raw);
    } catch (e) { return fallback; }
  };

  NvStore.prototype.set = function (key, value) {
    var raw = JSON.stringify(value);
    this.mem[key] = raw;
    if (!this.persistent) return true;
    try { window.localStorage.setItem(this.prefix + key, raw); return true; }
    catch (e) { return false; }   // quota exceeded -> memory copy still valid
  };

  NvStore.prototype.remove = function (key) {
    delete this.mem[key];
    if (this.persistent) { try { window.localStorage.removeItem(this.prefix + key); } catch (e) {} }
  };

  ns.NvStore = NvStore;
})(window.HbSim);

</script>
<script>
/* ==========================================================================
 * sensor.js  -  Optical sensor sources (MAX30102 simulation + real adapter)
 *
 * SENSOR SOURCE INTERFACE (duck-typed). Anything with these members can be
 * plugged into the firmware in main.js:
 *
 *   fs                       sample rate in Hz
 *   active                   true while the AFE is powered
 *   begin()                  power up / start a new scan
 *   end()                    power down
 *   pull(nowMs)              -> [{ t, red, ir }]  samples since last call
 *   setFingerPresent(bool)   (simulation only; real sensors ignore it)
 *
 * The simulated source uses a simple Beer-Lambert optical model so that the
 * red/IR DC levels depend on hemoglobin concentration, and the pulsatile
 * (AC) parts follow a PPG waveform whose red/IR ratio encodes SpO2.
 * That lets the rest of the pipeline run on data with realistic structure.
 * ========================================================================== */
(function (ns) {
  'use strict';
  var U = ns.util;

  /* ---- PPG pulse shape (one beat, 512-point lookup table) -------------- */
  function gauss(x, mu, s) { var d = (x - mu) / s; return Math.exp(-0.5 * d * d); }
  var LUT_N = 512, LUT = new Float64Array(LUT_N), LUT_MEAN = 0;
