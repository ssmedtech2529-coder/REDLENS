    h += '<circle class="dome-base" cx="252" cy="388" r="23"/><circle id="led-dome" class="dome" cx="252" cy="388" r="18"/>';
    h += '<text class="pin-t dk" x="318" y="375" text-anchor="end">R</text><text class="pin-t dk" x="318" y="396" text-anchor="end">G</text><text class="pin-t dk" x="318" y="417" text-anchor="end">B</text>';
    h += '<text class="chip-t dk" x="252" y="420" text-anchor="middle">COM\u2192GND</text>';
    h += '<text class="label" x="270" y="336" text-anchor="middle">RGB status LED</text>';
    h += '</g>';

    /* ---------------- buzzer ---------------- */
