  DisplayController.prototype._processing = function (d, s) {
    d.text(0, 0, s.name, 1);
    batteryLine(d, s, 8);
    d.textCenter(26, 'Estimating Hb' + dots(s.stateTime), 1);
    d.textCenter(37, 'Applying calibration', 1);
    d.progress(0, 52, 128, 8, U.clamp(s.stateTime / ns.Config.scan.processMs, 0, 1));
