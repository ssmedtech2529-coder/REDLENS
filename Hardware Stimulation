    h += '<g id="mod-max"><rect class="pcb-max" x="650" y="420" width="190" height="150" rx="8"/>' +
         '<rect class="win" x="722" y="438" width="104" height="52" rx="6"/>' +
         '<circle id="opt-red" class="opt red" cx="745" cy="464" r="9"/><circle class="pd" cx="774" cy="464" r="6"/><circle id="opt-ir" class="opt ir" cx="803" cy="464" r="9"/>' +
         '<text class="chip-t" x="745" y="486" text-anchor="middle">660</text><text class="chip-t" x="774" y="486" text-anchor="middle">PD</text><text class="chip-t" x="803" y="486" text-anchor="middle">880</text>' +
         '<rect class="chip" x="700" y="520" width="40" height="30" rx="3"/><text class="chip-t" x="720" y="539" text-anchor="middle">MAX</text>' +
         '<text class="chip-t" x="790" y="545" text-anchor="middle">MAX30102</text></g>';
    h += '<g id="mod-afe" style="display:none"><rect class="pcb-afe" x="650" y="420" width="190" height="150" rx="8"/>' +
         '<rect class="bpw" x="726" y="438" width="48" height="48" rx="3"/><path class="bpw-l" d="M726 462 h48 M750 438 v48"/>' +
         '<circle id="opt-red2" class="opt red" cx="796" cy="450" r="8"/><circle id="opt-ir2" class="opt ir" cx="796" cy="474" r="8"/>' +
