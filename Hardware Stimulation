<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Red Lens | Hardware Lab Simulator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ==========================================================================
 * styles.css - hardware simulator UI. White canvas, blue and gray theme.
 * ========================================================================== */
:root {
  --white: #fff; --mist: #f5f7fa; --ink: #1b2733; --slate: #5b6b7c; --line: #dde3ea;
  --blue: #1f5fbf; --navy: #0f3a7a; --sky: #2b8ce6; --green: #1e9e6a; --amber: #d98e04; --red: #d64545;
  --font: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  --pulse: 0; color-scheme: light;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--mist); color: var(--ink); font: 400 14px/1.5 var(--font); -webkit-font-smoothing: antialiased; }
h1, h2, h3, p { margin: 0; }
button, select, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--sky); outline-offset: 2px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
[hidden] { display: none !important; }

/* ---- toolbar ---------------------------------------------------------- */
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 10px 20px; background: var(--white); border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 11px; }
.logo { width: 32px; height: 32px; }
.brand h1 { font-size: 16px; font-weight: 600; color: var(--navy); letter-spacing: -0.01em; }
.brand p { color: var(--slate); font-size: 12px; }
.sim-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.sim-btn { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--blue); background: var(--blue); color: #fff; font-weight: 600; font-size: 13px; cursor: pointer; transition: background .15s; }
.sim-btn:hover { background: var(--navy); }
.sim-btn svg { fill: currentColor; }
.sim-btn .ic-stop { display: none; } .sim-btn.stop .ic-play { display: none; } .sim-btn.stop .ic-stop { display: block; }
.sim-btn.stop { background: var(--white); color: var(--red); border-color: #e3b0b0; }
.sim-btn.stop:hover { background: #fbeeee; }
.sim-btn.ghost { background: var(--white); color: var(--navy); border-color: #c4cfdb; font-weight: 500; }
.sim-btn.ghost:hover { background: var(--mist); }
.speed { display: inline-flex; align-items: center; gap: 6px; color: var(--slate); font-size: 12.5px; }
.speed select, .controls select { border: 1px solid #c4cfdb; border-radius: 8px; padding: 5px 8px; background: var(--white); color: var(--ink); }
.pill { display: inline-flex; align-items: center; gap: 7px; padding: 4px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 500; border: 1px solid var(--line); background: var(--mist); color: var(--slate); }
.pill i { width: 8px; height: 8px; border-radius: 50%; background: #aab5c1; }
.pill.run { color: #0f7a50; background: #e6f6ef; border-color: #bfe6d3; } .pill.run i { background: var(--green); animation: blink 1.4s infinite; }
.simtime { color: var(--slate); font-size: 12.5px; } .simtime b { font: 500 13px var(--mono); color: var(--navy); margin-left: 4px; }

.notice { display: flex; align-items: flex-start; gap: 10px; padding: 8px 20px; background: #eef4fc; color: var(--navy); border-bottom: 1px solid #d6e3f5; font-size: 13px; }
.notice svg { flex: none; margin-top: 2px; color: var(--blue); }

/* ---- stage layout ------------------------------------------------------ */
.stage { display: grid; grid-template-columns: minmax(0, 1fr) 372px; gap: 20px; padding: 16px 20px 28px; max-width: 1560px; margin: 0 auto; align-items: start; }
.workspace { min-width: 0; display: grid; gap: 16px; }
.btn { border: 1px solid #c4cfdb; background: var(--white); color: var(--navy); padding: 6px 12px; border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 13px; transition: background .15s, border-color .15s; }
.btn:hover { background: var(--mist); border-color: var(--blue); }
.btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; } .btn.primary:hover { background: var(--navy); }
.btn.sm { padding: 3px 9px; font-size: 12px; }
.btn:disabled { opacity: .5; cursor: default; }
.btn-row { display: flex; gap: 8px; flex-wrap: wrap; }

/* ---- circuit canvas ----------------------------------------------------- */
.canvas-card { background: var(--white); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.canvas-head { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 9px 16px; border-bottom: 1px solid var(--line); }
.canvas-head h2 { font-size: 13px; font-weight: 600; color: var(--navy); }
.canvas-head p { color: var(--slate); font-size: 12.5px; flex: 1; min-width: 220px; }
.nets { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; font-size: 12px; color: var(--slate); }
.nets i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
.circuit-wrap { position: relative; aspect-ratio: 1000 / 600; background: var(--white); }
#circuit { display: block; width: 100%; height: 100%; }
#oled { position: absolute; left: 67.2%; top: 10.33%; width: 25.6%; height: 21.33%; image-rendering: pixelated; border-radius: 2px; pointer-events: none; }

#circuit text { font-family: var(--font); user-select: none; }
.wire { fill: none; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
.flow { fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 2 12; opacity: 0; }
.flow.on { opacity: .95; animation: dash .7s linear infinite; } .flow.on.slow { animation-duration: 1.5s; }
@keyframes dash { to { stroke-dashoffset: -14; } }
.junction { fill: #5b6b7c; }
.flag path { fill: none; stroke: #5b6b7c; stroke-width: 1.7; stroke-linecap: round; }
.flag.red path { stroke: var(--red); } .flag.red circle { fill: var(--red); }
.flag-t { font-size: 9.5px; fill: var(--red); font-weight: 500; }
.tag { font-size: 9.5px; fill: #8795a5; } .label { font-size: 12px; font-weight: 500; fill: var(--slate); }
.res { fill: #ead9a8; stroke: #a08c55; stroke-width: 1; }

.part { cursor: pointer; }
.outline { fill: transparent; stroke: transparent; stroke-width: 1.6; }
.part:hover .outline { stroke: #9db9e0; stroke-dasharray: 5 4; }
.part.sel .outline { stroke: var(--blue); stroke-dasharray: 5 4; fill: rgba(31, 95, 191, .035); }

.pcb-esp { fill: #17324f; stroke: #0f2338; stroke-width: 1.5; }
.antenna { fill: none; stroke: #c9a24b; stroke-width: 2.2; stroke-linejoin: round; }
.shield { fill: #cdd5de; stroke: #9aa6b3; } .shield-t { font-size: 13px; font-weight: 600; fill: #4a5a6b; } .shield-t.s { font-size: 9.5px; font-weight: 500; }
.usb { fill: #aab4bf; stroke: #7b8794; }
.pin { fill: #d9b44a; stroke: #a8862c; stroke-width: 1; }
.pin-t { font-size: 9.5px; fill: #cfe0f3; font-weight: 500; } .pin-t.sm { font-size: 8.5px; } .pin-t.dk { fill: var(--slate); font-size: 10px; }
.chip-t { font-size: 9px; fill: #cfe0f3; } .chip-t.dk { fill: var(--slate); }
.pwr { fill: #35495f; } .pwr.on { fill: #3ddc97; filter: drop-shadow(0 0 4px #3ddc97); }
.pcb-oled { fill: #1a3a63; stroke: #10264a; stroke-width: 1.5; } .bezel { fill: #04070c; }
.pcb-max { fill: #2a3441; stroke: #1b2430; stroke-width: 1.5; } .pcb-afe { fill: #1f4d3a; stroke: #13352a; stroke-width: 1.5; }
.win { fill: #11161d; stroke: #4b586a; } .chip { fill: #11161d; stroke: #3b4757; }
.bpw { fill: #1b2a3a; stroke: #6a85a3; } .bpw-l { stroke: #6a85a3; stroke-width: 1; }
.opt { fill: #5a6370; transition: fill .15s; } .pd { fill: #7e8da0; }
.opt.red.emit { fill: #dc3228; } .opt.ir.emit { fill: #8b7bb8; }
svg.lit .opt.red.emit { filter: drop-shadow(0 0 calc(3px + var(--pulse) * 9px) rgba(255, 70, 60, .95)); }
svg.lit .opt.ir.emit { filter: drop-shadow(0 0 4px rgba(139, 123, 184, .9)); }

.finger { transform: translateY(-95px); opacity: 0; transition: transform .9s cubic-bezier(.3, .7, .2, 1), opacity .5s; }
.finger.hint { opacity: 1; animation: bob 1.4s ease-in-out infinite; }
.finger.down { opacity: 1; transform: translateY(0); animation: none; }
@keyframes bob { 0%, 100% { transform: translateY(-92px); } 50% { transform: translateY(-68px); } }
.finger-body { fill: #fff; fill-opacity: .95; stroke: var(--blue); stroke-width: 2.2; } .finger-nail { fill: #eaf1fb; stroke: #9db9e0; stroke-width: 1.4; }
svg.lit .finger-body { fill: #fff1ee; }
.hit-g { cursor: pointer; } .hint-t { font-size: 12px; font-weight: 600; fill: var(--blue); opacity: 0; transition: opacity .3s; pointer-events: none; } .hint-t.on { opacity: 1; }

.batt { fill: #3b6aa6; stroke: #274b78; stroke-width: 1.5; } .batt-nub { fill: #274b78; }
.batt-t { font-size: 11px; font-weight: 600; fill: #fff; } .batt-t.big { font-size: 17px; font-weight: 500; }
.seg { fill: rgba(255, 255, 255, .22); transition: fill .2s; } .seg.on { fill: #7ee0b0; } .seg.low { fill: #ff9a9a; }
.bolt { fill: #ffd84a; opacity: 0; } .bolt.on { opacity: 1; }
.comp { fill: #f3f6fa; stroke: #c4cfdb; }
.dome-base { fill: #dfe6ee; stroke: #b9c6d4; } .dome { fill: #aeb9c6; }
.bz-body { fill: #1b2430; } .bz-hole { fill: #5b6b7c; }
.bzw path { fill: none; stroke: #c4cfdb; stroke-width: 2; stroke-linecap: round; } .bzw.on path { stroke: #7b6aa8; animation: blink .18s infinite alternate; }
.bzw.on path:nth-child(2) { animation-delay: .06s; } .bzw.on path:nth-child(3) { animation-delay: .12s; }
.cap-ring { fill: #d3dce6; stroke: #9fb0c2; } .cap { fill: var(--blue); transform-box: fill-box; transform-origin: center; transition: transform .06s; } .cap-g.down .cap { transform: scale(.82); fill: var(--navy); }
.ble path { fill: none; stroke: #b6c2cf; stroke-width: 2.4; stroke-linecap: round; }
.ble.on path { stroke: var(--blue); animation: wave 1.2s infinite; } .ble.on path:nth-child(2) { animation-delay: .2s; } .ble.on path:nth-child(3) { animation-delay: .4s; }
.ble.adv path { stroke: var(--amber); animation: wave 2s infinite; }
@keyframes wave { 0%, 100% { opacity: .25; } 40% { opacity: 1; } }
@keyframes blink { 50% { opacity: .35; } }

/* ---- lower: dock + inspector -------------------------------------------- */
.lower { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; }
.dock, .inspector { background: var(--white); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.tabs { display: flex; border-bottom: 1px solid var(--line); background: var(--mist); }
.tab { border: 0; background: transparent; padding: 10px 16px; font-weight: 500; font-size: 13px; color: var(--slate); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
.tab:hover { color: var(--navy); } .tab[aria-selected="true"] { color: var(--navy); background: var(--white); border-bottom-color: var(--blue); }
.pane { min-height: 330px; }
.serial { margin: 0; height: 282px; overflow: auto; padding: 10px 14px; background: #0f1b2b; color: #cfe0f3; font: 400 12px/1.6 var(--mono); white-space: pre-wrap; }
.serial .ts { color: #6f87a3; } .serial .in { color: #8cc4ff; } .serial .ble { color: #86d6b0; }
.serial-in { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-top: 1px solid var(--line); }
.serial-in .prompt { font: 500 13px var(--mono); color: var(--blue); }
.serial-in input { flex: 1; min-width: 0; border: 1px solid #c4cfdb; border-radius: 8px; padding: 6px 10px; font: 400 12.5px var(--mono); background: var(--white); }
.monitor-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 8px 16px; border-bottom: 1px solid var(--line); }
.monitor-head .hint { color: var(--slate); font-size: 12.5px; }
.legend { display: flex; gap: 14px; font-size: 12px; color: var(--slate); }
.legend .k::before { content: ""; display: inline-block; width: 14px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
.legend .red::before { background: #c0392b; } .legend .ir::before { background: #6b7a8c; } .legend .filt::before { background: var(--blue); }
.canvas-wrap { position: relative; height: 230px; background: #fbfcfe; }
.canvas-wrap canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.overlay { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 20px; background: rgba(255, 255, 255, .78); color: var(--slate); font-weight: 500; transition: opacity .25s; }
.overlay.hide { opacity: 0; pointer-events: none; }
.metrics { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; border-top: 1px solid var(--line); }
.metrics div { padding: 8px 14px; border-right: 1px solid var(--line); } .metrics div:last-child { border-right: 0; }
.metrics dt { color: var(--slate); font-size: 12px; } .metrics dd { margin: 1px 0 0; font-weight: 500; color: var(--navy); font-variant-numeric: tabular-nums; }
.log { margin: 0; height: 330px; overflow: auto; padding: 12px 14px; background: var(--mist); font: 400 12px/1.6 var(--mono); color: #33465a; white-space: pre-wrap; }

.inspector { padding: 14px 16px 16px; }
.inspector h3 { font-size: 14px; font-weight: 600; color: var(--navy); margin-bottom: 10px; }
.kv { display: grid; grid-template-columns: auto 1fr; gap: 3px 14px; margin: 0 0 12px; font-size: 12.5px; }
.kv dt { color: var(--slate); } .kv dd { margin: 0; text-align: right; font-weight: 500; font-variant-numeric: tabular-nums; }
.note { color: var(--slate); font-size: 12.5px; margin: 0 0 10px; }
.controls { display: grid; gap: 10px; }
.controls label { display: grid; gap: 4px; font-size: 12.5px; color: var(--slate); } .controls output { float: right; color: var(--navy); font-weight: 500; }
label.inline { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--slate); }
.controls input[type=range] { width: 100%; accent-color: var(--blue); }

/* ---- phone ------------------------------------------------------------- */
.phone-col { position: sticky; top: 12px; }
.phone { width: 100%; max-width: 372px; margin: 0 auto; height: min(780px, calc(100vh - 28px)); min-height: 560px; display: flex; flex-direction: column; background: var(--white); border: 9px solid #2a3441; border-radius: 38px; overflow: hidden; box-shadow: 0 24px 50px -24px rgba(15, 58, 122, .5); }
.phone-status { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; padding: 10px 10px 8px; background: var(--white); }
.phone-scroll { flex: 1; overflow: auto; padding: 4px 16px 18px; }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--mist); color: var(--slate); font-size: 11.5px; font-weight: 500; }
.chip .dot { width: 7px; height: 7px; border-radius: 50%; background: #aab5c1; }
.chip.ok .dot { background: var(--green); } .chip.busy .dot { background: var(--sky); animation: blink 1s infinite; } .chip.warn .dot { background: var(--amber); } .chip.bad .dot { background: var(--red); }
#chip-batt { color: var(--navy); } #chip-batt.low { color: var(--red); }
.app-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 6px 0 16px; }
.app-head h2 { font-size: 18px; font-weight: 600; color: var(--navy); letter-spacing: -0.01em; } .app-head p { color: var(--slate); font-size: 12px; }

.stepper { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); list-style: none; margin: 0 0 18px; padding: 14px 0 0; }
.stepper::before { content: ""; position: absolute; left: 8.3%; right: 8.3%; top: 6px; height: 3px; border-radius: 2px; background: var(--line); }
.stepper-fill { position: absolute; left: 8.3%; top: 6px; height: 3px; border-radius: 2px; background: var(--blue); width: 0; transition: width .25s linear; }
.stepper li { position: relative; text-align: center; font-size: 10.5px; color: var(--slate); }
.stepper li::before { content: ""; position: absolute; left: 50%; top: -14px; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; background: var(--white); border: 2px solid #b9c6d4; z-index: 1; transition: background .2s, border-color .2s; }
.stepper li.done::before { background: var(--blue); border-color: var(--blue); } .stepper li.now { color: var(--navy); font-weight: 600; }
.stepper li.now::before { border-color: var(--blue); box-shadow: 0 0 0 4px rgba(31, 95, 191, .18); }
.stepper li.err { color: var(--red); font-weight: 600; } .stepper li.err::before { border-color: var(--red); background: var(--red); }

.lbl { display: block; color: var(--slate); font-size: 12px; }
.hb-card { border: 1px solid var(--line); border-left: 4px solid var(--blue); border-radius: 12px; padding: 14px 16px; margin-bottom: 12px; }
.hb-val { display: flex; align-items: baseline; gap: 8px; margin: 2px 0; }
#hb-val { font-size: 54px; line-height: 1.05; font-weight: 500; letter-spacing: -0.03em; color: var(--navy); font-variant-numeric: tabular-nums; } #hb-val.prov { color: #7d93b3; }
.unit { color: var(--slate); font-size: 14px; } .hb-sub { color: var(--slate); font-size: 12px; min-height: 18px; }
.range { margin-top: 12px; } .range-bar { position: relative; height: 6px; border-radius: 3px; background: var(--line); }
.range-bar i { position: absolute; top: -4px; width: 4px; height: 14px; border-radius: 2px; background: var(--blue); left: 0; opacity: 0; transition: left .5s ease, opacity .3s; }
.range-scale { display: flex; justify-content: space-between; font-size: 11px; color: var(--slate); margin-top: 6px; }
.vitals { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--mist); margin-bottom: 16px; }
.vital { padding: 10px 14px; border-bottom: 1px solid var(--line); } .vital:nth-child(odd) { border-right: 1px solid var(--line); } .vital:nth-last-child(-n+2) { border-bottom: 0; }
.vital b { display: inline-block; font-size: 24px; font-weight: 500; color: var(--navy); font-variant-numeric: tabular-nums; margin-top: 1px; }
.vital em { font-style: normal; color: var(--slate); font-size: 12px; margin-left: 5px; }
.vital:last-child b { font-size: 15px; display: block; } .vital:last-child em { display: block; margin: 1px 0 0; }
.qbar { display: flex; gap: 4px; margin-top: 5px; } .qbar i { flex: 1; height: 5px; border-radius: 3px; background: var(--line); transition: background .3s; }
.bar { height: 5px; border-radius: 3px; background: var(--line); margin-top: 7px; overflow: hidden; } .bar i { display: block; height: 100%; width: 0; background: var(--blue); transition: width .2s linear; }
.hist-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; } .hist-head h3 { font-size: 14px; color: var(--navy); }
.hist-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
.hist-list li { display: grid; grid-template-columns: 62px 70px 1fr auto; align-items: center; gap: 8px; padding: 8px 2px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 12.5px; }
.hist-list li:hover { background: #f0f5fb; } .h-time { color: var(--slate); font-variant-numeric: tabular-nums; } .h-hb { font-weight: 500; color: var(--navy); font-size: 15px; font-variant-numeric: tabular-nums; } .h-hb small { color: var(--slate); font-weight: 400; font-size: 10.5px; } .h-vit { color: var(--slate); font-size: 12px; }
.qtag { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11.5px; font-weight: 500; background: var(--mist); border: 1px solid var(--line); }
.qtag.Excellent { color: #0f7a50; background: #e6f6ef; border-color: #bfe6d3; } .qtag.Good { color: var(--blue); background: #e8f0fb; border-color: #c4d7f2; }
.qtag.Fair { color: #8a5a00; background: #fdf3de; border-color: #f0dca8; } .qtag.Poor { color: var(--red); background: #fbe9e9; border-color: #f0c4c4; }
.empty { padding: 14px 2px; color: var(--slate); font-size: 12.5px; }
.phone-safety { margin-top: 16px; padding: 10px 12px; border-radius: 10px; background: #eef4fc; color: var(--navy); font-size: 11.5px; line-height: 1.45; }

/* ---- modal / toast ----------------------------------------------------- */
.modal { position: fixed; inset: 0; background: rgba(15, 58, 122, .35); display: grid; place-items: center; padding: 20px; z-index: 50; }
.modal-box { background: var(--white); border-radius: 14px; width: min(900px, 100%); height: min(88vh, 900px); display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .45); }
.modal-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 18px; border-bottom: 1px solid var(--line); } .modal-head h3 { font-size: 15px; color: var(--navy); }
.modal iframe { flex: 1; border: 0; width: 100%; background: #fff; }
