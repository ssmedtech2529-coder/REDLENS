      default: break;
    }
  };

  Firmware.prototype._startScan = function (now) {
    if (this.battery.pct < 5 && !this.battery.charging) { this._error(['Battery too low', 'Connect USB charger'], now); return; }
    this.lossCount = 0; this.message = ''; this.errorLines = [];
    this.lastRecord = null;
    this._enter(S.PLACE, now);
