      '<path d="M' + (x + s * 14) + ' ' + (y - 7) + ' v14 M' + (x + s * 18) + ' ' + (y - 4) + ' v8 M' + (x + s * 22) + ' ' + (y - 1.5) + ' v3"/></g>';
  }
  function vcc(x, y, dir, label) {
