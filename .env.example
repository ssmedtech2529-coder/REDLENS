# =================================================================
# Red Lens — Non-Invasive Anemia Screening System
# Environment Variable Configuration
# =================================================================
# Instructions:
# 1. Copy this file to `backend/.env` (or run: `cp .env.example backend/.env`)
# 2. Add your API key below.
# 3. NEVER commit your real `.env` file to git. (It is already ignored in .gitignore)
# =================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000

# SQLite Database Location (defaults to backend/redlens.db)
DATABASE_PATH=backend/redlens.db

# -----------------------------------------------------------------
# Option A: OpenAI (Recommended for Chatbot & Clinical Support Agent)
# -----------------------------------------------------------------
# Obtain your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------
# Option B: Alternative OpenAI-Compatible Providers
# -----------------------------------------------------------------
# You can use Groq, OpenRouter, DeepSeek, or Ollama by setting:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-70b-versatile
# OPENAI_API_KEY=your_groq_api_key

# -----------------------------------------------------------------
# Option C: Google Gemini API (via OpenAI-compatible endpoint)
# -----------------------------------------------------------------
# Obtain your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# DEMO MODE NOTICE:
# If no API key is provided, Red Lens automatically operates in DEMO Mode.
# In DEMO Mode, the AI Agent answers standard clinical questions using
# an evidence-based clinical rules engine and deterministic screening data.
# -----------------------------------------------------------------
